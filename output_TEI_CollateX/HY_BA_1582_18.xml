<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_18">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_18_1">
        <l n="1" xml:id="HY_BA_1582_18_1_1">iam christe sol iustitiae</l>
        <l n="2" xml:id="HY_BA_1582_18_1_2">mentis dehiscant tenebrae</l>
        <l n="3" xml:id="HY_BA_1582_18_1_3">virtutum ut lux redeat</l>
        <l n="4" xml:id="HY_BA_1582_18_1_4">terris diem dum reparas</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_18_2">
        <l n="5" xml:id="HY_BA_1582_18_2_5">da tempus acceptabile</l>
        <l n="6" xml:id="HY_BA_1582_18_2_6">et poenitens cor tribue</l>
        <l n="7" xml:id="HY_BA_1582_18_2_7">convertat ut benignitas</l>
        <l n="8" xml:id="HY_BA_1582_18_2_8">quos longa suffert pietas</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_18_3">
        <l n="9" xml:id="HY_BA_1582_18_3_9">quiddamque poenitentiae</l>
        <l n="10" xml:id="HY_BA_1582_18_3_10">da ferre licet grandium</l>
        <l n="11" xml:id="HY_BA_1582_18_3_11">maiore tuo munere</l>
        <l n="12" xml:id="HY_BA_1582_18_3_12">quod demptio sit criminum</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_18_4">
        <l n="13" xml:id="HY_BA_1582_18_4_13">dies venit dies tua</l>
        <l n="14" xml:id="HY_BA_1582_18_4_14">in qua reflorent omnia</l>
        <l n="15" xml:id="HY_BA_1582_18_4_15">laetemur in hac ad tuam</l>
        <l n="16" xml:id="HY_BA_1582_18_4_16">per hanc reducti gratiam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_18_5">
        <l n="17" xml:id="HY_BA_1582_18_5_17">te rerum universitas</l>
        <l n="18" xml:id="HY_BA_1582_18_5_18">clemens adorat trinitas</l>
        <l n="19" xml:id="HY_BA_1582_18_5_19">et mox novi per veniam</l>
        <l n="20" xml:id="HY_BA_1582_18_5_20">novum canamus canticum amen</l>
      </lg>
    </body>
  </text>
</TEI>