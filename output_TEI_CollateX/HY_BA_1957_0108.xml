<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0108">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0108_1">
        <l n="1" xml:id="HY_BA_1957_0108_1_1">regis supremi nuncio</l>
        <l n="2" xml:id="HY_BA_1957_0108_1_2">festum sacremus canticum</l>
        <l n="3" xml:id="HY_BA_1957_0108_1_3">qui nos ab alto visitet</l>
        <l n="4" xml:id="HY_BA_1957_0108_1_4">caelique donis repleat</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0108_2">
        <l n="5" xml:id="HY_BA_1957_0108_2_5">hic iussa reddens numinis</l>
        <l n="6" xml:id="HY_BA_1957_0108_2_6">almam salutat virginem</l>
        <l n="7" xml:id="HY_BA_1957_0108_2_7">matrisque honorem deferens</l>
        <l n="8" xml:id="HY_BA_1957_0108_2_8">caelesti adimplet gratia</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0108_3">
        <l n="9" xml:id="HY_BA_1957_0108_3_9">maria secum provida</l>
        <l n="10" xml:id="HY_BA_1957_0108_3_10">vocem revolvens angeli</l>
        <l n="11" xml:id="HY_BA_1957_0108_3_11">arcana verbi cogitat</l>
        <l n="12" xml:id="HY_BA_1957_0108_3_12">turbata fatu mystico</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0108_4">
        <l n="13" xml:id="HY_BA_1957_0108_4_13">mentem serenans aliger</l>
        <l n="14" xml:id="HY_BA_1957_0108_4_14">velamen altum detegit</l>
        <l n="15" xml:id="HY_BA_1957_0108_4_15">fideque firma muniens</l>
        <l n="16" xml:id="HY_BA_1957_0108_4_16">castum timorem discutit</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0108_5">
        <l n="17" xml:id="HY_BA_1957_0108_5_17">ancilla fidens protinus</l>
        <l n="18" xml:id="HY_BA_1957_0108_5_18">votis supernis annuit</l>
        <l n="19" xml:id="HY_BA_1957_0108_5_19">partus futuri praescia</l>
        <l n="20" xml:id="HY_BA_1957_0108_5_20">salvo pudoris vinculo</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0108_6">
        <l n="21" xml:id="HY_BA_1957_0108_6_21">functus decoro munere</l>
        <l n="22" xml:id="HY_BA_1957_0108_6_22">victor triumphat gabriel</l>
        <l n="23" xml:id="HY_BA_1957_0108_6_23">astrisque demum redditus</l>
        <l n="24" xml:id="HY_BA_1957_0108_6_24">felix reponit nuncium</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0108_7">
        <l n="25" xml:id="HY_BA_1957_0108_7_25">nobis precator quaesumus</l>
        <l n="26" xml:id="HY_BA_1957_0108_7_26">adsis minister spiritus</l>
        <l n="27" xml:id="HY_BA_1957_0108_7_27">aures benignae virginis</l>
        <l n="28" xml:id="HY_BA_1957_0108_7_28">inflecte nostris vocibus</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0108_8">
        <l n="29" xml:id="HY_BA_1957_0108_8_29">patri simul cum filio</l>
        <l n="30" xml:id="HY_BA_1957_0108_8_30">ac spiritu paraclito</l>
        <l n="31" xml:id="HY_BA_1957_0108_8_31">sicut fuit sit gloria</l>
        <l n="32" xml:id="HY_BA_1957_0108_8_32">in saeculorum saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>