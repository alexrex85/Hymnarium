<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_MA_08">
  <text>
    <body>
      <lg n="1" xml:id="HY_MA_08_1">
        <l n="1" xml:id="HY_MA_08_1_1">inluminans altissimus</l>
        <l n="2" xml:id="HY_MA_08_1_2">micantium astrorum globos</l>
        <l n="3" xml:id="HY_MA_08_1_3">pax vita lumen veritas</l>
        <l n="4" xml:id="HY_MA_08_1_4">ihesu fave precantibus</l>
      </lg>
      <lg n="2" xml:id="HY_MA_08_2">
        <l n="5" xml:id="HY_MA_08_2_5">seu mystico baptismate</l>
        <l n="6" xml:id="HY_MA_08_2_6">fluenta iordanis retro</l>
        <l n="7" xml:id="HY_MA_08_2_7">conversa condam tertio</l>
        <l n="8" xml:id="HY_MA_08_2_8">praesenti sacraris die</l>
      </lg>
      <lg n="3" xml:id="HY_MA_08_3">
        <l n="9" xml:id="HY_MA_08_3_9">seu stella partum virginis</l>
        <l n="10" xml:id="HY_MA_08_3_10">caelo micans signaveris</l>
        <l n="11" xml:id="HY_MA_08_3_11">et hoc adoratum die</l>
        <l n="12" xml:id="HY_MA_08_3_12">praesepe magos duxeris</l>
      </lg>
      <lg n="4" xml:id="HY_MA_08_4">
        <l n="13" xml:id="HY_MA_08_4_13">vel hydriis plenis aqua</l>
        <l n="14" xml:id="HY_MA_08_4_14">vini saporem infuderis</l>
        <l n="15" xml:id="HY_MA_08_4_15">hausit minister conscius</l>
        <l n="16" xml:id="HY_MA_08_4_16">quod ipse non impleverat</l>
      </lg>
      <lg n="5" xml:id="HY_MA_08_5">
        <l n="17" xml:id="HY_MA_08_5_17">aquas colorari videns</l>
        <l n="18" xml:id="HY_MA_08_5_18">inebriari flumina</l>
        <l n="19" xml:id="HY_MA_08_5_19">mutata elementa stupent</l>
        <l n="20" xml:id="HY_MA_08_5_20">transire in usus alteros</l>
      </lg>
      <lg n="6" xml:id="HY_MA_08_6">
        <l n="21" xml:id="HY_MA_08_6_21">sic quinque millibus viris</l>
        <l n="22" xml:id="HY_MA_08_6_22">dum quinque panes dividunt</l>
        <l n="23" xml:id="HY_MA_08_6_23">edentium sub dentibus</l>
        <l n="24" xml:id="HY_MA_08_6_24">in ore crescebat cibus</l>
      </lg>
      <lg n="7" xml:id="HY_MA_08_7">
        <l n="25" xml:id="HY_MA_08_7_25">multiplicabatur magis</l>
        <l n="26" xml:id="HY_MA_08_7_26">dispendio panis suo</l>
        <l n="27" xml:id="HY_MA_08_7_27">quis haec videns mirabitur</l>
        <l n="28" xml:id="HY_MA_08_7_28">iuges meatus fontium</l>
      </lg>
      <lg n="8" xml:id="HY_MA_08_8">
        <l n="29" xml:id="HY_MA_08_8_29">inter manus frangentium</l>
        <l n="30" xml:id="HY_MA_08_8_30">panis rigatur profluus</l>
        <l n="31" xml:id="HY_MA_08_8_31">intacta quae non frangerat</l>
        <l n="32" xml:id="HY_MA_08_8_32">fragmenta subrepunt viri</l>
      </lg>
      <lg n="9" xml:id="HY_MA_08_9">
        <l n="33" xml:id="HY_MA_08_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_MA_08_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_MA_08_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_MA_08_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>