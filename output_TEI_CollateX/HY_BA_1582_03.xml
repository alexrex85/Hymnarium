<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_03">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_03_1">
        <l n="1" xml:id="HY_BA_1582_03_1_1">iam lucis orto sydere</l>
        <l n="2" xml:id="HY_BA_1582_03_1_2">deum precemur supplices</l>
        <l n="3" xml:id="HY_BA_1582_03_1_3">ut in diurnis actibus</l>
        <l n="4" xml:id="HY_BA_1582_03_1_4">nos servet a nocentibus</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_03_2">
        <l n="5" xml:id="HY_BA_1582_03_2_5">linguam refrenans temperet</l>
        <l n="6" xml:id="HY_BA_1582_03_2_6">ne litis orror insonet</l>
        <l n="7" xml:id="HY_BA_1582_03_2_7">visum fovendo contegat</l>
        <l n="8" xml:id="HY_BA_1582_03_2_8">ne vanitates hauriat</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_03_3">
        <l n="9" xml:id="HY_BA_1582_03_3_9">sint pura cordis intima</l>
        <l n="10" xml:id="HY_BA_1582_03_3_10">absistat et vecordia</l>
        <l n="11" xml:id="HY_BA_1582_03_3_11">carnis terat superbiam</l>
        <l n="12" xml:id="HY_BA_1582_03_3_12">potus cibique parcitas</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_03_4">
        <l n="13" xml:id="HY_BA_1582_03_4_13">ut cum dies abscesserit</l>
        <l n="14" xml:id="HY_BA_1582_03_4_14">noctemque sors reduxerit</l>
        <l n="15" xml:id="HY_BA_1582_03_4_15">mundi per abstinentiam</l>
        <l n="16" xml:id="HY_BA_1582_03_4_16">ipsi canamus gloriam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_03_5">
        <l n="17" xml:id="HY_BA_1582_03_5_17">deo patri sit gloria</l>
        <l n="18" xml:id="HY_BA_1582_03_5_18">eiusque soli filio</l>
        <l n="19" xml:id="HY_BA_1582_03_5_19">cum spiritu paraclito</l>
        <l n="20" xml:id="HY_BA_1582_03_5_20">et nunc et in perpetuum amen</l>
      </lg>
    </body>
  </text>
</TEI>