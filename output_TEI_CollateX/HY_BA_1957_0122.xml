<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0122">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0122_1">
        <l n="1" xml:id="HY_BA_1957_0122_1_1">vexilla christus inclyta</l>
        <l n="2" xml:id="HY_BA_1957_0122_1_2">late triumphans explicat</l>
        <l n="3" xml:id="HY_BA_1957_0122_1_3">gentes adeste supplices</l>
        <l n="4" xml:id="HY_BA_1957_0122_1_4">regique regum plaudite</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0122_2">
        <l n="5" xml:id="HY_BA_1957_0122_2_5">non ille regna cladibus</l>
        <l n="6" xml:id="HY_BA_1957_0122_2_6">non vi metuque subdidit</l>
        <l n="7" xml:id="HY_BA_1957_0122_2_7">alto levatus stipite</l>
        <l n="8" xml:id="HY_BA_1957_0122_2_8">amore traxit omnia</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0122_3">
        <l n="9" xml:id="HY_BA_1957_0122_3_9">o ter beata civitas</l>
        <l n="10" xml:id="HY_BA_1957_0122_3_10">cui rite christus imperat</l>
        <l n="11" xml:id="HY_BA_1957_0122_3_11">quae iussa pergit exequi</l>
        <l n="12" xml:id="HY_BA_1957_0122_3_12">edicta mundo caelitus</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0122_4">
        <l n="13" xml:id="HY_BA_1957_0122_4_13">non arma flagrant impia</l>
        <l n="14" xml:id="HY_BA_1957_0122_4_14">pax usque firmat foedera</l>
        <l n="15" xml:id="HY_BA_1957_0122_4_15">arridet et concordia</l>
        <l n="16" xml:id="HY_BA_1957_0122_4_16">tutus stat ordo civicus</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0122_5">
        <l n="17" xml:id="HY_BA_1957_0122_5_17">servat fides connubia</l>
        <l n="18" xml:id="HY_BA_1957_0122_5_18">iuventa pubet integra</l>
        <l n="19" xml:id="HY_BA_1957_0122_5_19">pudica florent limina</l>
        <l n="20" xml:id="HY_BA_1957_0122_5_20">domesticis virtutibus</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0122_6">
        <l n="21" xml:id="HY_BA_1957_0122_6_21">optata nobis splendeat</l>
        <l n="22" xml:id="HY_BA_1957_0122_6_22">lux ista rex dulcissime</l>
        <l n="23" xml:id="HY_BA_1957_0122_6_23">te pace adepta candida</l>
        <l n="24" xml:id="HY_BA_1957_0122_6_24">adoret orbis subditus</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0122_7">
        <l n="25" xml:id="HY_BA_1957_0122_7_25">iesu tibi sit gloria</l>
        <l n="26" xml:id="HY_BA_1957_0122_7_26">qui sceptra mundi temperas</l>
        <l n="27" xml:id="HY_BA_1957_0122_7_27">cum patre et almo spiritu</l>
        <l n="28" xml:id="HY_BA_1957_0122_7_28">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>