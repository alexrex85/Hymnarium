<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0210">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0210_1">
        <l n="1" xml:id="HY_BA_1957_0210_1_1">simpliciani carmine</l>
        <l n="2" xml:id="HY_BA_1957_0210_1_2">laudem canamus supplici</l>
        <l n="3" xml:id="HY_BA_1957_0210_1_3">qui luce gaudens aureo</l>
        <l n="4" xml:id="HY_BA_1957_0210_1_4">fidem coronat lumine</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0210_2">
        <l n="5" xml:id="HY_BA_1957_0210_2_5">praecessor hunc ambrosius</l>
        <l n="6" xml:id="HY_BA_1957_0210_2_6">insignit isque proximus</l>
        <l n="7" xml:id="HY_BA_1957_0210_2_7">morti senem vicarium</l>
        <l n="8" xml:id="HY_BA_1957_0210_2_8">sedem mereri praedicat</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0210_3">
        <l n="9" xml:id="HY_BA_1957_0210_3_9">felix patris successio</l>
        <l n="10" xml:id="HY_BA_1957_0210_3_10">haeres beatus infulae</l>
        <l n="11" xml:id="HY_BA_1957_0210_3_11">ter voce dignus insubrum</l>
        <l n="12" xml:id="HY_BA_1957_0210_3_12">praesul tiara dicitur</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0210_4">
        <l n="13" xml:id="HY_BA_1957_0210_4_13">subit senecta praegravis</l>
        <l n="14" xml:id="HY_BA_1957_0210_4_14">gregis regendi pondera</l>
        <l n="15" xml:id="HY_BA_1957_0210_4_15">sed mentis ignitus vigor</l>
        <l n="16" xml:id="HY_BA_1957_0210_4_16">et sanctitas vires dedit</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0210_5">
        <l n="17" xml:id="HY_BA_1957_0210_5_17">caelestis orbi claruit</l>
        <l n="18" xml:id="HY_BA_1957_0210_5_18">doctrina toti praesulis</l>
        <l n="19" xml:id="HY_BA_1957_0210_5_19">eumque patrum consulit</l>
        <l n="20" xml:id="HY_BA_1957_0210_5_20">coetus rogantum punicus</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0210_6">
        <l n="21" xml:id="HY_BA_1957_0210_6_21">aurelium pius monet</l>
        <l n="22" xml:id="HY_BA_1957_0210_6_22">sectam manetis impiam</l>
        <l n="23" xml:id="HY_BA_1957_0210_6_23">damnare et unda naufragam</l>
        <l n="24" xml:id="HY_BA_1957_0210_6_24">fidem salubri quaerere</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0210_7">
        <l n="25" xml:id="HY_BA_1957_0210_7_25">verbi dei praeconio</l>
        <l n="26" xml:id="HY_BA_1957_0210_7_26">spargit salutis semina</l>
        <l n="27" xml:id="HY_BA_1957_0210_7_27">invicta veri numinis</l>
        <l n="28" xml:id="HY_BA_1957_0210_7_28">vexilla romae subrigens</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0210_8">
        <l n="29" xml:id="HY_BA_1957_0210_8_29">iubet sacratis plurimos</l>
        <l n="30" xml:id="HY_BA_1957_0210_8_30">caelo renasci fluctibus</l>
        <l n="31" xml:id="HY_BA_1957_0210_8_31">quos rhetor inter nobilis</l>
        <l n="32" xml:id="HY_BA_1957_0210_8_32">et victorinus credidit</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0210_9">
        <l n="33" xml:id="HY_BA_1957_0210_9_33">deo patri sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0210_9_34">eiusque soli filio</l>
        <l n="35" xml:id="HY_BA_1957_0210_9_35">cum spiritu paraclito</l>
        <l n="36" xml:id="HY_BA_1957_0210_9_36">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
</TEI>