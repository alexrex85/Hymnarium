<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_33">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_33_1">
        <l n="1" xml:id="HY_BA_1582_33_1_1">beate martyr prospera</l>
        <l n="2" xml:id="HY_BA_1582_33_1_2">diem triumphalem tuum</l>
        <l n="3" xml:id="HY_BA_1582_33_1_3">quo sanguine merces tibi</l>
        <l n="4" xml:id="HY_BA_1582_33_1_4">corona vincenti datur</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_33_2">
        <l n="5" xml:id="HY_BA_1582_33_2_5">hic te ex tenebris saeculi</l>
        <l n="6" xml:id="HY_BA_1582_33_2_6">tortore victo et iudice</l>
        <l n="7" xml:id="HY_BA_1582_33_2_7">evexit ad coelum dies</l>
        <l n="8" xml:id="HY_BA_1582_33_2_8">christoque ovantem reddidit</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_33_3">
        <l n="9" xml:id="HY_BA_1582_33_3_9">nunc angelorum particeps</l>
        <l n="10" xml:id="HY_BA_1582_33_3_10">luces in insigni stola</l>
        <l n="11" xml:id="HY_BA_1582_33_3_11">quam testis indomabilis</l>
        <l n="12" xml:id="HY_BA_1582_33_3_12">rivis cruoris laveras</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_33_4">
        <l n="13" xml:id="HY_BA_1582_33_4_13">levita de tribu sacra</l>
        <l n="14" xml:id="HY_BA_1582_33_4_14">minister altaris dei</l>
        <l n="15" xml:id="HY_BA_1582_33_4_15">septem ex columnis lacteis</l>
        <l n="16" xml:id="HY_BA_1582_33_4_16">martyr triumpho nobilis</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_33_5">
        <l n="17" xml:id="HY_BA_1582_33_5_17">tu solus o bis inclyte</l>
        <l n="18" xml:id="HY_BA_1582_33_5_18">solus brabii duplicis</l>
        <l n="19" xml:id="HY_BA_1582_33_5_19">palmas tulisti tu duas</l>
        <l n="20" xml:id="HY_BA_1582_33_5_20">simul parasti laureas</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1582_33_6">
        <l n="21" xml:id="HY_BA_1582_33_6_21">in morte victor aspera</l>
        <l n="22" xml:id="HY_BA_1582_33_6_22">dum deinde post mortem pari</l>
        <l n="23" xml:id="HY_BA_1582_33_6_23">victor triumpho proteris</l>
        <l n="24" xml:id="HY_BA_1582_33_6_24">solo latronem corpore</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1582_33_7">
        <l n="25" xml:id="HY_BA_1582_33_7_25">per vincla flammas ungulas</l>
        <l n="26" xml:id="HY_BA_1582_33_7_26">per carceralem stipitem</l>
        <l n="27" xml:id="HY_BA_1582_33_7_27">per fragmen illud testeum</l>
        <l n="28" xml:id="HY_BA_1582_33_7_28">quo partu crevit gloria</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1582_33_8">
        <l n="29" xml:id="HY_BA_1582_33_8_29">adesto nunc et percipe</l>
        <l n="30" xml:id="HY_BA_1582_33_8_30">voces precantum supplices</l>
        <l n="31" xml:id="HY_BA_1582_33_8_31">nostri reatus efficax</l>
        <l n="32" xml:id="HY_BA_1582_33_8_32">orator ad thronum dei</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1582_33_9">
        <l n="33" xml:id="HY_BA_1582_33_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_BA_1582_33_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_BA_1582_33_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_BA_1582_33_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>