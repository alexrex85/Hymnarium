<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_29">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_29_1">
        <l n="1" xml:id="HY_BA_1582_29_1_1">post petrum primum principem</l>
        <l n="2" xml:id="HY_BA_1582_29_1_2">andreas est apostolus</l>
        <l n="3" xml:id="HY_BA_1582_29_1_3">verbum salutis praedicans</l>
        <l n="4" xml:id="HY_BA_1582_29_1_4">achaia in provincia</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_29_2">
        <l n="5" xml:id="HY_BA_1582_29_2_5">captus in patra oppido</l>
        <l n="6" xml:id="HY_BA_1582_29_2_6">diro traditur carceri</l>
        <l n="7" xml:id="HY_BA_1582_29_2_7">ferali poena caeditur</l>
        <l n="8" xml:id="HY_BA_1582_29_2_8">tortor callet vesania</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_29_3">
        <l n="9" xml:id="HY_BA_1582_29_3_9">dilaniatus ictibus</l>
        <l n="10" xml:id="HY_BA_1582_29_3_10">ligno crucis suspenditur</l>
        <l n="11" xml:id="HY_BA_1582_29_3_11">non cessat vivens biduo</l>
        <l n="12" xml:id="HY_BA_1582_29_3_12">fidem docere populum</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_29_4">
        <l n="13" xml:id="HY_BA_1582_29_4_13">clamor plebis attollitur</l>
        <l n="14" xml:id="HY_BA_1582_29_4_14">charus deo exposcitur</l>
        <l n="15" xml:id="HY_BA_1582_29_4_15">reddi pius et innocens</l>
        <l n="16" xml:id="HY_BA_1582_29_4_16">sanctus bonusque quaeritur</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_29_5">
        <l n="17" xml:id="HY_BA_1582_29_5_17">fallax tunc ad patibulum</l>
        <l n="18" xml:id="HY_BA_1582_29_5_18">quasi solutum properat</l>
        <l n="19" xml:id="HY_BA_1582_29_5_19">devotus martyr in poenis</l>
        <l n="20" xml:id="HY_BA_1582_29_5_20">orat ne arctioribus</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1582_29_6">
        <l n="21" xml:id="HY_BA_1582_29_6_21">loris resolvat impius</l>
        <l n="22" xml:id="HY_BA_1582_29_6_22">divinis demptus muniis</l>
        <l n="23" xml:id="HY_BA_1582_29_6_23">frater instigat iurgiis</l>
        <l n="24" xml:id="HY_BA_1582_29_6_24">iustisque querimoniis</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1582_29_7">
        <l n="25" xml:id="HY_BA_1582_29_7_25">eant tecum quae tua sunt</l>
        <l n="26" xml:id="HY_BA_1582_29_7_26">aegea o durissime</l>
        <l n="27" xml:id="HY_BA_1582_29_7_27">completa eius passio</l>
        <l n="28" xml:id="HY_BA_1582_29_7_28">devicto hoste callido</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1582_29_8">
        <l n="29" xml:id="HY_BA_1582_29_8_29">imploret ergo meritis</l>
        <l n="30" xml:id="HY_BA_1582_29_8_30">suis pro nostris actibus</l>
        <l n="31" xml:id="HY_BA_1582_29_8_31">ut mereamur consequi</l>
        <l n="32" xml:id="HY_BA_1582_29_8_32">in fine sancti premia</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1582_29_9">
        <l n="33" xml:id="HY_BA_1582_29_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_BA_1582_29_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_BA_1582_29_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_BA_1582_29_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>