<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0151">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0151_1">
        <l n="1" xml:id="HY_BA_1957_0151_1_1">dignum canentes angeli</l>
        <l n="2" xml:id="HY_BA_1957_0151_1_2">carmen iosepho pangite</l>
        <l n="3" xml:id="HY_BA_1957_0151_1_3">qui dormienti numinis</l>
        <l n="4" xml:id="HY_BA_1957_0151_1_4">olim tulistis nuntia</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0151_2">
        <l n="5" xml:id="HY_BA_1957_0151_2_5">regina caeli iungitur</l>
        <l n="6" xml:id="HY_BA_1957_0151_2_6">intacta virgo virgini</l>
        <l n="7" xml:id="HY_BA_1957_0151_2_7">dotata solis lumine</l>
        <l n="8" xml:id="HY_BA_1957_0151_2_8">repleta sancto spiritu</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0151_3">
        <l n="9" xml:id="HY_BA_1957_0151_3_9">divinus infans nascitur</l>
        <l n="10" xml:id="HY_BA_1957_0151_3_10">gestit parens coercitum</l>
        <l n="11" xml:id="HY_BA_1957_0151_3_11">vagire verbum fasciis</l>
        <l n="12" xml:id="HY_BA_1957_0151_3_12">risumque flere caelitum</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0151_4">
        <l n="13" xml:id="HY_BA_1957_0151_4_13">fuga iubetur praepeti</l>
        <l n="14" xml:id="HY_BA_1957_0151_4_14">servare numen angelo</l>
        <l n="15" xml:id="HY_BA_1957_0151_4_15">paret monenti aegyptiis</l>
        <l n="16" xml:id="HY_BA_1957_0151_4_16">lucem tenebris deferens</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0151_5">
        <l n="17" xml:id="HY_BA_1957_0151_5_17">regum creatus sanguine</l>
        <l n="18" xml:id="HY_BA_1957_0151_5_18">pater dei nutritius</l>
        <l n="19" xml:id="HY_BA_1957_0151_5_19">prolem superni regiam</l>
        <l n="20" xml:id="HY_BA_1957_0151_5_20">in orbe patris educat</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0151_6">
        <l n="21" xml:id="HY_BA_1957_0151_6_21">amissus inde quaeritur</l>
        <l n="22" xml:id="HY_BA_1957_0151_6_22">puer repertus gaudium</l>
        <l n="23" xml:id="HY_BA_1957_0151_6_23">reddit paternum subditus</l>
        <l n="24" xml:id="HY_BA_1957_0151_6_24">patris laborem sublevat</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0151_7">
        <l n="25" xml:id="HY_BA_1957_0151_7_25">astante demum filio</l>
        <l n="26" xml:id="HY_BA_1957_0151_7_26">sponsaque laetus interit</l>
        <l n="27" xml:id="HY_BA_1957_0151_7_27">praesente vita funeris</l>
        <l n="28" xml:id="HY_BA_1957_0151_7_28">vicem iosephus despicit</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0151_8">
        <l n="29" xml:id="HY_BA_1957_0151_8_29">te deprecamur spiritus</l>
        <l n="30" xml:id="HY_BA_1957_0151_8_30">defende nostros corporum</l>
        <l n="31" xml:id="HY_BA_1957_0151_8_31">ut liberati carcere</l>
        <l n="32" xml:id="HY_BA_1957_0151_8_32">aeterna vincla nesciant</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0151_9">
        <l n="33" xml:id="HY_BA_1957_0151_9_33">iesu tibi sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0151_9_34">qui natus es de virgine</l>
        <l n="35" xml:id="HY_BA_1957_0151_9_35">cum patre et almo spiritu</l>
        <l n="36" xml:id="HY_BA_1957_0151_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>