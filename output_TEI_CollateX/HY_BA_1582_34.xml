<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_34">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_34_1">
        <l n="1" xml:id="HY_BA_1582_34_1_1">agathae sacrae virginis</l>
        <l n="2" xml:id="HY_BA_1582_34_1_2">diem festum recolimus</l>
        <l n="3" xml:id="HY_BA_1582_34_1_3">in quo tyrannum superans</l>
        <l n="4" xml:id="HY_BA_1582_34_1_4">palmam tulit martyrii</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_34_2">
        <l n="5" xml:id="HY_BA_1582_34_2_5">quintianus tunc tyrannus</l>
        <l n="6" xml:id="HY_BA_1582_34_2_6">consularis siciliae</l>
        <l n="7" xml:id="HY_BA_1582_34_2_7">audiens famam virginis</l>
        <l n="8" xml:id="HY_BA_1582_34_2_8">frendere coepit invidus</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_34_3">
        <l n="9" xml:id="HY_BA_1582_34_3_9">vitiorum affectibus</l>
        <l n="10" xml:id="HY_BA_1582_34_3_10">mentem vexabat invidam</l>
        <l n="11" xml:id="HY_BA_1582_34_3_11">deo dicatam virginem</l>
        <l n="12" xml:id="HY_BA_1582_34_3_12">diro furore ut perderet</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_34_4">
        <l n="13" xml:id="HY_BA_1582_34_4_13">statim adsunt miserrimi</l>
        <l n="14" xml:id="HY_BA_1582_34_4_14">eius volentes pandere</l>
        <l n="15" xml:id="HY_BA_1582_34_4_15">religionem solidam</l>
        <l n="16" xml:id="HY_BA_1582_34_4_16">quam tenet ab infantia</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_34_5">
        <l n="17" xml:id="HY_BA_1582_34_5_17">sisti iubet tunc martyrem</l>
        <l n="18" xml:id="HY_BA_1582_34_5_18">suis pro tribunalibus</l>
        <l n="19" xml:id="HY_BA_1582_34_5_19">eamque sic alloquitur</l>
        <l n="20" xml:id="HY_BA_1582_34_5_20">ut diis cervicem flecteret</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1582_34_6">
        <l n="21" xml:id="HY_BA_1582_34_6_21">sed nil valens insania</l>
        <l n="22" xml:id="HY_BA_1582_34_6_22">in mammam torquet virginem</l>
        <l n="23" xml:id="HY_BA_1582_34_6_23">testas et acutissimas</l>
        <l n="24" xml:id="HY_BA_1582_34_6_24">igni succensas adhibet</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1582_34_7">
        <l n="25" xml:id="HY_BA_1582_34_7_25">cuius medendis artubus</l>
        <l n="26" xml:id="HY_BA_1582_34_7_26">sanctus adest apostolus</l>
        <l n="27" xml:id="HY_BA_1582_34_7_27">verbo qui curat vulnera</l>
        <l n="28" xml:id="HY_BA_1582_34_7_28">quae carnifex infixerat</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1582_34_8">
        <l n="29" xml:id="HY_BA_1582_34_8_29">hinc ad sepulchrum advenit</l>
        <l n="30" xml:id="HY_BA_1582_34_8_30">amictus albis iuvenis</l>
        <l n="31" xml:id="HY_BA_1582_34_8_31">mentemque sanctam praedicat</l>
        <l n="32" xml:id="HY_BA_1582_34_8_32">patriae salutem plurimam</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1582_34_9">
        <l n="33" xml:id="HY_BA_1582_34_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_BA_1582_34_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_BA_1582_34_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_BA_1582_34_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>