<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_MA_38">
  <text>
    <body>
      <lg n="1" xml:id="HY_MA_38_1">
        <l n="1" xml:id="HY_MA_38_1_1">nunc sancte nobis spiritus</l>
        <l n="2" xml:id="HY_MA_38_1_2">unum patri cum filio</l>
        <l n="3" xml:id="HY_MA_38_1_3">dignare promptus ingeri</l>
        <l n="4" xml:id="HY_MA_38_1_4">nostro refusus pectori</l>
      </lg>
      <lg n="2" xml:id="HY_MA_38_2">
        <l n="5" xml:id="HY_MA_38_2_5">os lingua mens sensus vigor</l>
        <l n="6" xml:id="HY_MA_38_2_6">confessionem personet</l>
        <l n="7" xml:id="HY_MA_38_2_7">flammescat igne caritas</l>
        <l n="8" xml:id="HY_MA_38_2_8">accendat ardor proximos</l>
      </lg>
      <lg n="3" xml:id="HY_MA_38_3">
        <l n="9" xml:id="HY_MA_38_3_9">praesta pater piissime</l>
        <l n="10" xml:id="HY_MA_38_3_10">per iesum christum dominum</l>
        <l n="11" xml:id="HY_MA_38_3_11">qui tecum in perpetuum</l>
        <l n="12" xml:id="HY_MA_38_3_12">regnat cum sancto spiritu amen</l>
      </lg>
    </body>
  </text>
</TEI>