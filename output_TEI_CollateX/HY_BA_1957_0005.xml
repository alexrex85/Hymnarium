<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0005">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0005_1">
        <l n="1" xml:id="HY_BA_1957_0005_1_1">nunc sancte nobis spiritus</l>
        <l n="2" xml:id="HY_BA_1957_0005_1_2">unum patri cum filio</l>
        <l n="3" xml:id="HY_BA_1957_0005_1_3">dignare promptus ingeri</l>
        <l n="4" xml:id="HY_BA_1957_0005_1_4">nostro refusus pectori</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0005_2">
        <l n="5" xml:id="HY_BA_1957_0005_2_5">os lingua mens sensus vigor</l>
        <l n="6" xml:id="HY_BA_1957_0005_2_6">confessionem personent</l>
        <l n="7" xml:id="HY_BA_1957_0005_2_7">flammescat igne charitas</l>
        <l n="8" xml:id="HY_BA_1957_0005_2_8">accendat ardor proximos</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0005_3">
        <l n="9" xml:id="HY_BA_1957_0005_3_9">praesta pater piissime</l>
        <l n="10" xml:id="HY_BA_1957_0005_3_10">per iesum christum dominum</l>
        <l n="11" xml:id="HY_BA_1957_0005_3_11">qui tecum in perpetuum</l>
        <l n="12" xml:id="HY_BA_1957_0005_3_12">regnat cum sancto spiritu amen</l>
      </lg>
    </body>
  </text>
