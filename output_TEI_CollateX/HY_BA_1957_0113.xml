<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0113">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0113_1">
        <l n="1" xml:id="HY_BA_1957_0113_1_1">sebastiani martyris</l>
        <l n="2" xml:id="HY_BA_1957_0113_1_2">concivis almi supplices</l>
        <l n="3" xml:id="HY_BA_1957_0113_1_3">diem sacratum vocibus</l>
        <l n="4" xml:id="HY_BA_1957_0113_1_4">canamus omnes debitis</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0113_2">
        <l n="5" xml:id="HY_BA_1957_0113_2_5">athleta christi nobilis</l>
        <l n="6" xml:id="HY_BA_1957_0113_2_6">ardens amore praelii</l>
        <l n="7" xml:id="HY_BA_1957_0113_2_7">linquit tepentem patriam</l>
        <l n="8" xml:id="HY_BA_1957_0113_2_8">pugnamque romae destinat</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0113_3">
        <l n="9" xml:id="HY_BA_1957_0113_3_9">hic cultor alti dogmatis</l>
        <l n="10" xml:id="HY_BA_1957_0113_3_10">virtute plenus caelica</l>
        <l n="11" xml:id="HY_BA_1957_0113_3_11">idola damnans inclyti</l>
        <l n="12" xml:id="HY_BA_1957_0113_3_12">trophaea sperat martyris</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0113_4">
        <l n="13" xml:id="HY_BA_1957_0113_4_13">loris revinctus plurimis</l>
        <l n="14" xml:id="HY_BA_1957_0113_4_14">qua stipes ingens tollitur</l>
        <l n="15" xml:id="HY_BA_1957_0113_4_15">vibrata tela suscipit</l>
        <l n="16" xml:id="HY_BA_1957_0113_4_16">umbone nudo pectoris</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0113_5">
        <l n="17" xml:id="HY_BA_1957_0113_5_17">fit silva corpus ferrea</l>
        <l n="18" xml:id="HY_BA_1957_0113_5_18">sed aere mens constantior</l>
        <l n="19" xml:id="HY_BA_1957_0113_5_19">ut molle ferrum despicit</l>
        <l n="20" xml:id="HY_BA_1957_0113_5_20">ferum precatur saeviat</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0113_6">
        <l n="21" xml:id="HY_BA_1957_0113_6_21">manantis unda sanguinis</l>
        <l n="22" xml:id="HY_BA_1957_0113_6_22">exangue corpus nuntiat</l>
        <l n="23" xml:id="HY_BA_1957_0113_6_23">sed casta noctu foemina</l>
        <l n="24" xml:id="HY_BA_1957_0113_6_24">plagas tumentes recreat</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0113_7">
        <l n="25" xml:id="HY_BA_1957_0113_7_25">caeleste robur militi</l>
        <l n="26" xml:id="HY_BA_1957_0113_7_26">adacta praebent vulnera</l>
        <l n="27" xml:id="HY_BA_1957_0113_7_27">rursum tyrannum provocans</l>
        <l n="28" xml:id="HY_BA_1957_0113_7_28">expirat inter vulnera</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0113_8">
        <l n="29" xml:id="HY_BA_1957_0113_8_29">nunc caeli in arce considens</l>
        <l n="30" xml:id="HY_BA_1957_0113_8_30">bellator o fortissime</l>
        <l n="31" xml:id="HY_BA_1957_0113_8_31">luem fugando civium</l>
        <l n="32" xml:id="HY_BA_1957_0113_8_32">tuere clemens corpora</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0113_9">
        <l n="33" xml:id="HY_BA_1957_0113_9_33">patri simulque filio</l>
        <l n="34" xml:id="HY_BA_1957_0113_9_34">tibique sancte spiritus</l>
        <l n="35" xml:id="HY_BA_1957_0113_9_35">sicut fuit sit iugiter</l>
        <l n="36" xml:id="HY_BA_1957_0113_9_36">saeclum per omne gloria amen</l>
      </lg>
    </body>
  </text>
</TEI>