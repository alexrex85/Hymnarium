<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0304">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0304_1">
        <l n="1" xml:id="HY_BA_1957_0304_1_1">iesu corona celsior</l>
        <l n="2" xml:id="HY_BA_1957_0304_1_2">et veritas sublimior</l>
        <l n="3" xml:id="HY_BA_1957_0304_1_3">qui confitenti servulo</l>
        <l n="4" xml:id="HY_BA_1957_0304_1_4">reddis perenne praemium</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0304_2">
        <l n="5" xml:id="HY_BA_1957_0304_2_5">da supplicanti coetui</l>
        <l n="6" xml:id="HY_BA_1957_0304_2_6">huius rogatu tristium</l>
        <l n="7" xml:id="HY_BA_1957_0304_2_7">remissionem criminum</l>
        <l n="8" xml:id="HY_BA_1957_0304_2_8">rumpendo nexum vinculi</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0304_3">
        <l n="9" xml:id="HY_BA_1957_0304_3_9">anni reverso tempore</l>
        <l n="10" xml:id="HY_BA_1957_0304_3_10">dies reluxit lumine</l>
        <l n="11" xml:id="HY_BA_1957_0304_3_11">quo sanctus hic de corpore</l>
        <l n="12" xml:id="HY_BA_1957_0304_3_12">sedes adivit caelitum</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0304_4">
        <l n="13" xml:id="HY_BA_1957_0304_4_13">hinc vana terrae gaudia</l>
        <l n="14" xml:id="HY_BA_1957_0304_4_14">et laeta cultu praedia</l>
        <l n="15" xml:id="HY_BA_1957_0304_4_15">polluta sorde deputans</l>
        <l n="16" xml:id="HY_BA_1957_0304_4_16">ovans tenet caelestia</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0304_5">
        <l n="17" xml:id="HY_BA_1957_0304_5_17">te christe rex piissime</l>
        <l n="18" xml:id="HY_BA_1957_0304_5_18">hic confitendo iugiter</l>
        <l n="19" xml:id="HY_BA_1957_0304_5_19">calcavit imi fortiter</l>
        <l n="20" xml:id="HY_BA_1957_0304_5_20">regem superbum tartari</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0304_6">
        <l n="21" xml:id="HY_BA_1957_0304_6_21">virtute firmus et fide</l>
        <l n="22" xml:id="HY_BA_1957_0304_6_22">amore christi fervidus</l>
        <l n="23" xml:id="HY_BA_1957_0304_6_23">ieiuna membra deferens</l>
        <l n="24" xml:id="HY_BA_1957_0304_6_24">dapes supernas obtinet</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0304_7">
        <l n="25" xml:id="HY_BA_1957_0304_7_25">proinde te piissime</l>
        <l n="26" xml:id="HY_BA_1957_0304_7_26">precamur omnes supplices</l>
        <l n="27" xml:id="HY_BA_1957_0304_7_27">nobis ut huius gratia</l>
        <l n="28" xml:id="HY_BA_1957_0304_7_28">noxae remittas debita</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0304_8">
        <l n="29" xml:id="HY_BA_1957_0304_8_29">deo patri sit gloria</l>
        <l n="30" xml:id="HY_BA_1957_0304_8_30">eiusque soli filio</l>
        <l n="31" xml:id="HY_BA_1957_0304_8_31">cum spiritu paraclito</l>
        <l n="32" xml:id="HY_BA_1957_0304_8_32">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>