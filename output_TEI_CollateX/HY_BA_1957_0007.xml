  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0007_1">
        <l n="1" xml:id="HY_BA_1957_0007_1_1">rerum deus tenax vigor</l>
        <l n="2" xml:id="HY_BA_1957_0007_1_2">immotus in te permanens</l>
        <l n="3" xml:id="HY_BA_1957_0007_1_3">lucis diurnae tempora</l>
        <l n="4" xml:id="HY_BA_1957_0007_1_4">successibus determinans</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0007_2">
        <l n="5" xml:id="HY_BA_1957_0007_2_5">largire clarum vespere</l>
        <l n="6" xml:id="HY_BA_1957_0007_2_6">quo vita nusquam decidat</l>
        <l n="7" xml:id="HY_BA_1957_0007_2_7">sed praemium mortis sacrae</l>
        <l n="8" xml:id="HY_BA_1957_0007_2_8">perennis instet gloria</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0007_3">
        <l n="9" xml:id="HY_BA_1957_0007_3_9">praesta pater piissime</l>
        <l n="10" xml:id="HY_BA_1957_0007_3_10">per iesum christum dominum</l>
        <l n="11" xml:id="HY_BA_1957_0007_3_11">qui tecum in perpetuum</l>
        <l n="12" xml:id="HY_BA_1957_0007_3_12">regnat cum sancto spiritu amen</l>
      </lg>
    </body>
