<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0167">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0167_1">
        <l n="1" xml:id="HY_BA_1957_0167_1_1">legis supernae nuntio</l>
        <l n="2" xml:id="HY_BA_1957_0167_1_2">laudes canamus barnabae</l>
        <l n="3" xml:id="HY_BA_1957_0167_1_3">qui missus urbem numini</l>
        <l n="4" xml:id="HY_BA_1957_0167_1_4">urbique numen attulit</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0167_2">
        <l n="5" xml:id="HY_BA_1957_0167_2_5">fundum paternum distrahit</l>
        <l n="6" xml:id="HY_BA_1957_0167_2_6">empturus agro sidera</l>
        <l n="7" xml:id="HY_BA_1957_0167_2_7">almoque plenus spiritu</l>
        <l n="8" xml:id="HY_BA_1957_0167_2_8">verbum revelat gentibus</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0167_3">
        <l n="9" xml:id="HY_BA_1957_0167_3_9">dum spargit ignes caelicos</l>
        <l n="10" xml:id="HY_BA_1957_0167_3_10">incendit aras daemonum</l>
        <l n="11" xml:id="HY_BA_1957_0167_3_11">signisque et ore fulminans</l>
        <l n="12" xml:id="HY_BA_1957_0167_3_12">nomen tonantis respuit</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0167_4">
        <l n="13" xml:id="HY_BA_1957_0167_4_13">sedes deinde gestiens</l>
        <l n="14" xml:id="HY_BA_1957_0167_4_14">adit parentes insubrum</l>
        <l n="15" xml:id="HY_BA_1957_0167_4_15">intrare sed diis negat</l>
        <l n="16" xml:id="HY_BA_1957_0167_4_16">profana cultis moenia</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0167_5">
        <l n="17" xml:id="HY_BA_1957_0167_5_17">qua semen admittit solum</l>
        <l n="18" xml:id="HY_BA_1957_0167_5_18">semen salutis iniicit</l>
        <l n="19" xml:id="HY_BA_1957_0167_5_19">crucisque signa subrigens</l>
        <l n="20" xml:id="HY_BA_1957_0167_5_20">ascribit axi milites</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0167_6">
        <l n="21" xml:id="HY_BA_1957_0167_6_21">mox fonte sacro civium</l>
        <l n="22" xml:id="HY_BA_1957_0167_6_22">submissa mergit tempora</l>
        <l n="23" xml:id="HY_BA_1957_0167_6_23">et primus aris immolat</l>
        <l n="24" xml:id="HY_BA_1957_0167_6_24">caelestis agni victimam</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0167_7">
        <l n="25" xml:id="HY_BA_1957_0167_7_25">nunc inter astra lumine</l>
        <l n="26" xml:id="HY_BA_1957_0167_7_26">gaudens beato caelitum</l>
        <l n="27" xml:id="HY_BA_1957_0167_7_27">tuere quos fons et tuus</l>
        <l n="28" xml:id="HY_BA_1957_0167_7_28">cinis sepultus consecrat</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0167_8">
        <l n="29" xml:id="HY_BA_1957_0167_8_29">patri simulque filio</l>
        <l n="30" xml:id="HY_BA_1957_0167_8_30">tibique sancte spiritus</l>
        <l n="31" xml:id="HY_BA_1957_0167_8_31">sicut fuit sit iugiter</l>
        <l n="32" xml:id="HY_BA_1957_0167_8_32">saeclum per omne gloria amen</l>
      </lg>
    </body>
  </text>
</TEI>