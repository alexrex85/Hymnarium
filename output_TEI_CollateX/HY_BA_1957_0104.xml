<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0104">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0104_1">
        <l n="1" xml:id="HY_BA_1957_0104_1_1">deo fruentes fulgidae</l>
        <l n="2" xml:id="HY_BA_1957_0104_1_2">salvete cives patriae</l>
        <l n="3" xml:id="HY_BA_1957_0104_1_3">regni micantis aulici</l>
        <l n="4" xml:id="HY_BA_1957_0104_1_4">portus beantis incolae</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0104_2">
        <l n="5" xml:id="HY_BA_1957_0104_2_5">solis nitore perpetis</l>
        <l n="6" xml:id="HY_BA_1957_0104_2_6">regina gaudet siderum</l>
        <l n="7" xml:id="HY_BA_1957_0104_2_7">urbis volantes muniunt</l>
        <l n="8" xml:id="HY_BA_1957_0104_2_8">caelestis arcem milites</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0104_3">
        <l n="9" xml:id="HY_BA_1957_0104_3_9">vallatur urbs iaspide</l>
        <l n="10" xml:id="HY_BA_1957_0104_3_10">fundant lapilli moenia</l>
        <l n="11" xml:id="HY_BA_1957_0104_3_11">illic prophetis assident</l>
        <l n="12" xml:id="HY_BA_1957_0104_3_12">legis duces apostoli</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0104_4">
        <l n="13" xml:id="HY_BA_1957_0104_4_13">hic candidatus martyrum</l>
        <l n="14" xml:id="HY_BA_1957_0104_4_14">trophaea fert exercitus</l>
        <l n="15" xml:id="HY_BA_1957_0104_4_15">qui dimicantes plurimo</l>
        <l n="16" xml:id="HY_BA_1957_0104_4_16">vicere mortem sanguine</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0104_5">
        <l n="17" xml:id="HY_BA_1957_0104_5_17">hic infulati praesules</l>
        <l n="18" xml:id="HY_BA_1957_0104_5_18">et literarum lumina</l>
        <l n="19" xml:id="HY_BA_1957_0104_5_19">illic sacerdotes sacra</l>
        <l n="20" xml:id="HY_BA_1957_0104_5_20">agni fruuntur victima</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0104_6">
        <l n="21" xml:id="HY_BA_1957_0104_6_21">ieiunia eremus convenis</l>
        <l n="22" xml:id="HY_BA_1957_0104_6_22">apponit aeternas dapes</l>
        <l n="23" xml:id="HY_BA_1957_0104_6_23">hic virgines castissima</l>
        <l n="24" xml:id="HY_BA_1957_0104_6_24">sponso maritant lilia</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0104_7">
        <l n="25" xml:id="HY_BA_1957_0104_7_25">et vos avete caelites</l>
        <l n="26" xml:id="HY_BA_1957_0104_7_26">quos nostra tellus aethere</l>
        <l n="27" xml:id="HY_BA_1957_0104_7_27">donavit astris civium</l>
        <l n="28" xml:id="HY_BA_1957_0104_7_28">beata mittens agmina</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0104_8">
        <l n="29" xml:id="HY_BA_1957_0104_8_29">o turba magna respice</l>
        <l n="30" xml:id="HY_BA_1957_0104_8_30">pulchrae sionis exules</l>
        <l n="31" xml:id="HY_BA_1957_0104_8_31">fac nos serentes lacrymis</l>
        <l n="32" xml:id="HY_BA_1957_0104_8_32">referre messem gaudii</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0104_9">
        <l n="33" xml:id="HY_BA_1957_0104_9_33">deo patri sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0104_9_34">eiusque soli filio</l>
        <l n="35" xml:id="HY_BA_1957_0104_9_35">cum spiritu paraclito</l>
        <l n="36" xml:id="HY_BA_1957_0104_9_36">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
</TEI>