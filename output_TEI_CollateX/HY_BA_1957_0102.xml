<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0102">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0102_1">
        <l n="1" xml:id="HY_BA_1957_0102_1_1">custos preces mortalium</l>
        <l n="2" xml:id="HY_BA_1957_0102_1_2">audi canoras angele</l>
        <l n="3" xml:id="HY_BA_1957_0102_1_3">quos magnus orbis conditor</l>
        <l n="4" xml:id="HY_BA_1957_0102_1_4">tuae dedit custodiae</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0102_2">
        <l n="5" xml:id="HY_BA_1957_0102_2_5">nos saevientis igneo</l>
        <l n="6" xml:id="HY_BA_1957_0102_2_6">draconis ore libera</l>
        <l n="7" xml:id="HY_BA_1957_0102_2_7">nostrum genus qui noxiae</l>
        <l n="8" xml:id="HY_BA_1957_0102_2_8">fructu fefellit arboris</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0102_3">
        <l n="9" xml:id="HY_BA_1957_0102_3_9">si quando tentet devium</l>
        <l n="10" xml:id="HY_BA_1957_0102_3_10">decepta planta tramitem</l>
        <l n="11" xml:id="HY_BA_1957_0102_3_11">humana caeli dirige</l>
        <l n="12" xml:id="HY_BA_1957_0102_3_12">ad semitam vestigia</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0102_4">
        <l n="13" xml:id="HY_BA_1957_0102_4_13">momenta nostri singula</l>
        <l n="14" xml:id="HY_BA_1957_0102_4_14">defende tutor spiritus</l>
        <l n="15" xml:id="HY_BA_1957_0102_4_15">et deserentem corpora</l>
        <l n="16" xml:id="HY_BA_1957_0102_4_16">astris repone patriis</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0102_5">
        <l n="17" xml:id="HY_BA_1957_0102_5_17">deo patri sit gloria</l>
        <l n="18" xml:id="HY_BA_1957_0102_5_18">eiusque soli filio</l>
        <l n="19" xml:id="HY_BA_1957_0102_5_19">cum spiritu paraclito</l>
        <l n="20" xml:id="HY_BA_1957_0102_5_20">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
</TEI>