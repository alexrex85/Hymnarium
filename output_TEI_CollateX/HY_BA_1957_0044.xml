<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0044">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0044_1">
        <l n="1" xml:id="HY_BA_1957_0044_1_1">summi parentis filio</l>
        <l n="2" xml:id="HY_BA_1957_0044_1_2">patri futuri saeculi</l>
        <l n="3" xml:id="HY_BA_1957_0044_1_3">pacis beatae principi</l>
        <l n="4" xml:id="HY_BA_1957_0044_1_4">promamus ore canticum</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0044_2">
        <l n="5" xml:id="HY_BA_1957_0044_2_5">qui charitatis victima</l>
        <l n="6" xml:id="HY_BA_1957_0044_2_6">verbum dei factum caro</l>
        <l n="7" xml:id="HY_BA_1957_0044_2_7">mortale periturum genus</l>
        <l n="8" xml:id="HY_BA_1957_0044_2_8">fuso redemit sanguine</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0044_3">
        <l n="9" xml:id="HY_BA_1957_0044_3_9">volens ferali ab arbore</l>
        <l n="10" xml:id="HY_BA_1957_0044_3_10">en pendet agnus innocens</l>
        <l n="11" xml:id="HY_BA_1957_0044_3_11">animamque magnam devovet</l>
        <l n="12" xml:id="HY_BA_1957_0044_3_12">peccata multorum ferens</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0044_4">
        <l n="13" xml:id="HY_BA_1957_0044_4_13">manus pedesque vulnere</l>
        <l n="14" xml:id="HY_BA_1957_0044_4_14">grandi cruentum lanceae</l>
        <l n="15" xml:id="HY_BA_1957_0044_4_15">late terebrat saeviens</l>
        <l n="16" xml:id="HY_BA_1957_0044_4_16">immane in exsanguem furor</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0044_5">
        <l n="17" xml:id="HY_BA_1957_0044_5_17">mortale iam chirographum</l>
        <l n="18" xml:id="HY_BA_1957_0044_5_18">christo litante scinditur</l>
        <l n="19" xml:id="HY_BA_1957_0044_5_19">sanctoque pacis foedere</l>
        <l n="20" xml:id="HY_BA_1957_0044_5_20">beata iam sedes patet</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0044_6">
        <l n="21" xml:id="HY_BA_1957_0044_6_21">heu quantus ardor quantaque</l>
        <l n="22" xml:id="HY_BA_1957_0044_6_22">vis iesum amoris impulit</l>
        <l n="23" xml:id="HY_BA_1957_0044_6_23">ut dira passus sanguine</l>
        <l n="24" xml:id="HY_BA_1957_0044_6_24">poenas nocentum solveret</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0044_7">
        <l n="25" xml:id="HY_BA_1957_0044_7_25">iramque patris vindicem</l>
        <l n="26" xml:id="HY_BA_1957_0044_7_26">nostri misertus flecteret</l>
        <l n="27" xml:id="HY_BA_1957_0044_7_27">una expiandis omnium</l>
        <l n="28" xml:id="HY_BA_1957_0044_7_28">oblata noxis hostia</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0044_8">
        <l n="29" xml:id="HY_BA_1957_0044_8_29">o iesu id unus potes</l>
        <l n="30" xml:id="HY_BA_1957_0044_8_30">largitor alme desuper</l>
        <l n="31" xml:id="HY_BA_1957_0044_8_31">immitte tu tepentibus</l>
        <l n="32" xml:id="HY_BA_1957_0044_8_32">amoris ignem cordibus</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0044_9">
        <l n="33" xml:id="HY_BA_1957_0044_9_33">deo patri sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0044_9_34">eiusque soli filio</l>
        <l n="35" xml:id="HY_BA_1957_0044_9_35">cum spiritu paraclito</l>
        <l n="36" xml:id="HY_BA_1957_0044_9_36">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
