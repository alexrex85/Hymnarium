<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_MA_02">
  <text>
    <body>
      <lg n="1" xml:id="HY_MA_02_1">
        <l n="1" xml:id="HY_MA_02_1_1">post petrum primum principem</l>
        <l n="2" xml:id="HY_MA_02_1_2">andreas apostolus</l>
        <l n="3" xml:id="HY_MA_02_1_3">salutis verbum praedicans</l>
        <l n="4" xml:id="HY_MA_02_1_4">in achaia provintia</l>
      </lg>
      <lg n="2" xml:id="HY_MA_02_2">
        <l n="5" xml:id="HY_MA_02_2_5">captus in patra oppido</l>
        <l n="6" xml:id="HY_MA_02_2_6">traditur diro carceri</l>
        <l n="7" xml:id="HY_MA_02_2_7">ferali poena ceditur</l>
        <l n="8" xml:id="HY_MA_02_2_8">tortor callet vesania</l>
      </lg>
      <lg n="3" xml:id="HY_MA_02_3">
        <l n="9" xml:id="HY_MA_02_3_9">dilaniatis ictibus</l>
        <l n="10" xml:id="HY_MA_02_3_10">ligno crucis suspenditur</l>
        <l n="11" xml:id="HY_MA_02_3_11">biduo vivens non cessat</l>
        <l n="12" xml:id="HY_MA_02_3_12">fidem docere populum</l>
      </lg>
      <lg n="4" xml:id="HY_MA_02_4">
        <l n="13" xml:id="HY_MA_02_4_13">clamor plebis attollitur</l>
        <l n="14" xml:id="HY_MA_02_4_14">carus deo exposcitur</l>
        <l n="15" xml:id="HY_MA_02_4_15">reddi iustus et innocens</l>
        <l n="16" xml:id="HY_MA_02_4_16">sanctus et bonus quaeritur</l>
      </lg>
      <lg n="5" xml:id="HY_MA_02_5">
        <l n="17" xml:id="HY_MA_02_5_17">fallax ad patibulum</l>
        <l n="18" xml:id="HY_MA_02_5_18">quasi ad solvendum properat</l>
        <l n="19" xml:id="HY_MA_02_5_19">devotus martyr in poenis</l>
        <l n="20" xml:id="HY_MA_02_5_20">orat ne artioribus</l>
      </lg>
      <lg n="6" xml:id="HY_MA_02_6">
        <l n="21" xml:id="HY_MA_02_6_21">loris resolvat impius</l>
        <l n="22" xml:id="HY_MA_02_6_22">divinis indeptus muniis</l>
        <l n="23" xml:id="HY_MA_02_6_23">frater instigat iurgiis</l>
        <l n="24" xml:id="HY_MA_02_6_24">iustisque quaerimoniis</l>
      </lg>
      <lg n="7" xml:id="HY_MA_02_7">
        <l n="25" xml:id="HY_MA_02_7_25">eant tecum quae tua sunt</l>
        <l n="26" xml:id="HY_MA_02_7_26">egeatha durissime</l>
        <l n="27" xml:id="HY_MA_02_7_27">completa eius passio</l>
        <l n="28" xml:id="HY_MA_02_7_28">devicto hoste callido</l>
      </lg>
      <lg n="8" xml:id="HY_MA_02_8">
        <l n="29" xml:id="HY_MA_02_8_29">imploret ergo meritis</l>
        <l n="30" xml:id="HY_MA_02_8_30">suis pro nostris actibus</l>
        <l n="31" xml:id="HY_MA_02_8_31">ut mereamur consequi</l>
        <l n="32" xml:id="HY_MA_02_8_32">sancta in fine premia</l>
      </lg>
      <lg n="9" xml:id="HY_MA_02_9">
        <l n="33" xml:id="HY_MA_02_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_MA_02_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_MA_02_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_MA_02_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>