<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_MA_01">
  <text>
    <body>
      <lg n="1" xml:id="HY_MA_01_1">
        <l n="1" xml:id="HY_MA_01_1_1">bellator armis inclitus</l>
        <l n="2" xml:id="HY_MA_01_1_2">martinus actu nobilis</l>
        <l n="3" xml:id="HY_MA_01_1_3">quae gesserit miracula</l>
        <l n="4" xml:id="HY_MA_01_1_4">hymnis canamus debitis</l>
      </lg>
      <lg n="2" xml:id="HY_MA_01_2">
        <l n="5" xml:id="HY_MA_01_2_5">qui frigoris sub tempore</l>
        <l n="6" xml:id="HY_MA_01_2_6">dum clamide nudum tegit</l>
        <l n="7" xml:id="HY_MA_01_2_7">mox christo ipsam concidit</l>
        <l n="8" xml:id="HY_MA_01_2_8">se veste tectum prodidit</l>
      </lg>
      <lg n="3" xml:id="HY_MA_01_3">
        <l n="9" xml:id="HY_MA_01_3_9">tres arte sancta pallidos</l>
        <l n="10" xml:id="HY_MA_01_3_10">resuscitavit mortuos</l>
        <l n="11" xml:id="HY_MA_01_3_11">de febre catecuminum</l>
        <l n="12" xml:id="HY_MA_01_3_12">et alterum suspendio</l>
      </lg>
      <lg n="4" xml:id="HY_MA_01_4">
        <l n="13" xml:id="HY_MA_01_4_13">orationis ambitu</l>
        <l n="14" xml:id="HY_MA_01_4_14">latro sepultus proditur</l>
        <l n="15" xml:id="HY_MA_01_4_15">qua non cadebat impetu</l>
        <l n="16" xml:id="HY_MA_01_4_16">pinus reflexa ducitur</l>
      </lg>
      <lg n="5" xml:id="HY_MA_01_5">
        <l n="17" xml:id="HY_MA_01_5_17">profana dum succendere</l>
        <l n="18" xml:id="HY_MA_01_5_18">taere flammam repulit</l>
        <l n="19" xml:id="HY_MA_01_5_19">quo extincta sunt incendia imbris</l>
        <l n="20" xml:id="HY_MA_01_5_20">fuit praesentia</l>
      </lg>
      <lg n="6" xml:id="HY_MA_01_6">
        <l n="21" xml:id="HY_MA_01_6_21">humore de paralisi</l>
        <l n="22" xml:id="HY_MA_01_6_22">curat puellam debilem</l>
        <l n="23" xml:id="HY_MA_01_6_23">morbique rasit fomitem</l>
        <l n="24" xml:id="HY_MA_01_6_24">sancti liquoris unguine</l>
      </lg>
      <lg n="7" xml:id="HY_MA_01_7">
        <l n="25" xml:id="HY_MA_01_7_25">pacem leproso dans viro</l>
        <l n="26" xml:id="HY_MA_01_7_26">sordes fugavit ulcerum</l>
        <l n="27" xml:id="HY_MA_01_7_27">et quod lavaret morbidum</l>
        <l n="28" xml:id="HY_MA_01_7_28">iordanis est in osculo</l>
      </lg>
      <lg n="8" xml:id="HY_MA_01_8">
        <l n="29" xml:id="HY_MA_01_8_29">his et per orbem cognitis</l>
        <l n="30" xml:id="HY_MA_01_8_30">in gentibus miraculis</l>
        <l n="31" xml:id="HY_MA_01_8_31">possessor alti spiritus</l>
        <l n="32" xml:id="HY_MA_01_8_32">nunc regnat in caelestibus</l>
      </lg>
      <lg n="9" xml:id="HY_MA_01_9">
        <l n="33" xml:id="HY_MA_01_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_MA_01_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_MA_01_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_MA_01_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>