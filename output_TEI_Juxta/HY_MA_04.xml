<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_MA_04">
  <text>
    <body>
      <lg n="1" xml:id="HY_MA_04_1">
        <l n="1" xml:id="HY_MA_04_1_1">mysterium ecclesiae</l>
        <l n="2" xml:id="HY_MA_04_1_2">hymnum christo referimus</l>
        <l n="3" xml:id="HY_MA_04_1_3">quem genuit puerpera</l>
        <l n="4" xml:id="HY_MA_04_1_4">verbum patris in filio</l>
      </lg>
      <lg n="2" xml:id="HY_MA_04_2">
        <l n="5" xml:id="HY_MA_04_2_5">sola in sexu foemina</l>
        <l n="6" xml:id="HY_MA_04_2_6">electa es in saeculo</l>
        <l n="7" xml:id="HY_MA_04_2_7">quae meruisti dominum</l>
        <l n="8" xml:id="HY_MA_04_2_8">sanctum portare in utero</l>
      </lg>
      <lg n="3" xml:id="HY_MA_04_3">
        <l n="9" xml:id="HY_MA_04_3_9">vates antiqui temporis</l>
        <l n="10" xml:id="HY_MA_04_3_10">praedixerat quod factum est</l>
        <l n="11" xml:id="HY_MA_04_3_11">quia virgo conciperet</l>
        <l n="12" xml:id="HY_MA_04_3_12">et pareret emanuhel</l>
      </lg>
      <lg n="4" xml:id="HY_MA_04_4">
        <l n="13" xml:id="HY_MA_04_4_13">mysterium hoc magnum est</l>
        <l n="14" xml:id="HY_MA_04_4_14">mariae quod concessum est</l>
        <l n="15" xml:id="HY_MA_04_4_15">ut deum per quem omnia</l>
        <l n="16" xml:id="HY_MA_04_4_16">esse videret prodere</l>
      </lg>
      <lg n="5" xml:id="HY_MA_04_5">
        <l n="17" xml:id="HY_MA_04_5_17">vere gratia plena es</l>
        <l n="18" xml:id="HY_MA_04_5_18">et gloriosa permanes</l>
        <l n="19" xml:id="HY_MA_04_5_19">quia ex te nobis natus est christus</l>
        <l n="20" xml:id="HY_MA_04_5_20">per quem facta sunt omnia</l>
      </lg>
      <lg n="6" xml:id="HY_MA_04_6">
        <l n="21" xml:id="HY_MA_04_6_21">pastores qui audierunt</l>
        <l n="22" xml:id="HY_MA_04_6_22">gloriam deo cantarunt</l>
        <l n="23" xml:id="HY_MA_04_6_23">cucurrerunt in bethleem</l>
        <l n="24" xml:id="HY_MA_04_6_24">natum videre dominum</l>
      </lg>
      <lg n="7" xml:id="HY_MA_04_7">
        <l n="25" xml:id="HY_MA_04_7_25">sic magi ab ortu solis</l>
        <l n="26" xml:id="HY_MA_04_7_26">per stellae inditium</l>
        <l n="27" xml:id="HY_MA_04_7_27">portantes typum gentium</l>
        <l n="28" xml:id="HY_MA_04_7_28">primi offerunt munera</l>
      </lg>
      <lg n="8" xml:id="HY_MA_04_8">
        <l n="29" xml:id="HY_MA_04_8_29">rogemus ergo populi</l>
        <l n="30" xml:id="HY_MA_04_8_30">dei matrem et virginem</l>
        <l n="31" xml:id="HY_MA_04_8_31">ut ipsa nobis impetret</l>
        <l n="32" xml:id="HY_MA_04_8_32">pacem et indulgentiam</l>
      </lg>
      <lg n="9" xml:id="HY_MA_04_9">
        <l n="33" xml:id="HY_MA_04_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_MA_04_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_MA_04_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_MA_04_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>