<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0016">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0016_1">
        <l n="1" xml:id="HY_BA_1957_0016_1_1">supplex sacramus canticum</l>
        <l n="2" xml:id="HY_BA_1957_0016_1_2">divino iesu nomini</l>
        <l n="3" xml:id="HY_BA_1957_0016_1_3">quod astra terrae et inferi</l>
        <l n="4" xml:id="HY_BA_1957_0016_1_4">laudant adorant et tremunt</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0016_2">
        <l n="5" xml:id="HY_BA_1957_0016_2_5">nomen salutis nuntium</l>
        <l n="6" xml:id="HY_BA_1957_0016_2_6">supra omne nomen prominens</l>
        <l n="7" xml:id="HY_BA_1957_0016_2_7">fons vitae origo gratiae</l>
        <l n="8" xml:id="HY_BA_1957_0016_2_8">caelestis arrha gloriae</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0016_3">
        <l n="9" xml:id="HY_BA_1957_0016_3_9">o melle nomen dulcius</l>
        <l n="10" xml:id="HY_BA_1957_0016_3_10">quod corde et ore personans</l>
        <l n="11" xml:id="HY_BA_1957_0016_3_11">curas dolores daemones</l>
        <l n="12" xml:id="HY_BA_1957_0016_3_12">mulcet retundit dissipat</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0016_4">
        <l n="13" xml:id="HY_BA_1957_0016_4_13">hoc nomen invocantibus</l>
        <l n="14" xml:id="HY_BA_1957_0016_4_14">sit iuge nobis gaudium</l>
        <l n="15" xml:id="HY_BA_1957_0016_4_15">vitae laborem temperans</l>
        <l n="16" xml:id="HY_BA_1957_0016_4_16">mortis timorem diluens</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0016_5">
        <l n="17" xml:id="HY_BA_1957_0016_5_17">iesu tuo sit nomini</l>
        <l n="18" xml:id="HY_BA_1957_0016_5_18">cum patre et almo spiritu</l>
        <l n="19" xml:id="HY_BA_1957_0016_5_19">regnans piis in cordibus</l>
        <l n="20" xml:id="HY_BA_1957_0016_5_20">aeterna laus et gloria amen</l>
      </lg>
    </body>
  </text>
