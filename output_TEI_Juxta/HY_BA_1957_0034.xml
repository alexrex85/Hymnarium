<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0034">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0034_1">
        <l n="1" xml:id="HY_BA_1957_0034_1_1">veni creator spiritus</l>
        <l n="2" xml:id="HY_BA_1957_0034_1_2">mentes tuorum visita</l>
        <l n="3" xml:id="HY_BA_1957_0034_1_3">imple superna gratia</l>
        <l n="4" xml:id="HY_BA_1957_0034_1_4">quae tu creasti pectora</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0034_2">
        <l n="5" xml:id="HY_BA_1957_0034_2_5">qui paracletus diceris</l>
        <l n="6" xml:id="HY_BA_1957_0034_2_6">donum dei altissimi</l>
        <l n="7" xml:id="HY_BA_1957_0034_2_7">fons vivus ignis charitas</l>
        <l n="8" xml:id="HY_BA_1957_0034_2_8">et spiritalis unctio</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0034_3">
        <l n="9" xml:id="HY_BA_1957_0034_3_9">tu septiformis munere</l>
        <l n="10" xml:id="HY_BA_1957_0034_3_10">dexterae dei tu digitus</l>
        <l n="11" xml:id="HY_BA_1957_0034_3_11">tu rite promissum patris</l>
        <l n="12" xml:id="HY_BA_1957_0034_3_12">sermone ditans guttura</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0034_4">
        <l n="13" xml:id="HY_BA_1957_0034_4_13">accende lumen sensibus</l>
        <l n="14" xml:id="HY_BA_1957_0034_4_14">infunde amorem cordibus</l>
        <l n="15" xml:id="HY_BA_1957_0034_4_15">infirma nostri corporis</l>
        <l n="16" xml:id="HY_BA_1957_0034_4_16">virtute firmans perpeti</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0034_5">
        <l n="17" xml:id="HY_BA_1957_0034_5_17">hostem repellas longius</l>
        <l n="18" xml:id="HY_BA_1957_0034_5_18">pacemque dones protinus</l>
        <l n="19" xml:id="HY_BA_1957_0034_5_19">ductore sic te praevio</l>
        <l n="20" xml:id="HY_BA_1957_0034_5_20">vitemus omne noxium</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0034_6">
        <l n="21" xml:id="HY_BA_1957_0034_6_21">per te sciamus da patrem</l>
        <l n="22" xml:id="HY_BA_1957_0034_6_22">noscamus atque filium</l>
        <l n="23" xml:id="HY_BA_1957_0034_6_23">te utriusque spiritum</l>
        <l n="24" xml:id="HY_BA_1957_0034_6_24">credamus omni tempore</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0034_7">
        <l n="25" xml:id="HY_BA_1957_0034_7_25">gloria patri domino</l>
        <l n="26" xml:id="HY_BA_1957_0034_7_26">natoque qui a mortuis</l>
        <l n="27" xml:id="HY_BA_1957_0034_7_27">surrexit ac paraclito</l>
        <l n="28" xml:id="HY_BA_1957_0034_7_28">in saeculorum saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>