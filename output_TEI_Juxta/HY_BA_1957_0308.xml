<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0308">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0308_1">
        <l n="1" xml:id="HY_BA_1957_0308_1_1">memento salutis auctor</l>
        <l n="2" xml:id="HY_BA_1957_0308_1_2">quod nostri quondam corporis</l>
        <l n="3" xml:id="HY_BA_1957_0308_1_3">ex illibata virgine</l>
        <l n="4" xml:id="HY_BA_1957_0308_1_4">nascendo formam sumpseris</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0308_2">
        <l n="5" xml:id="HY_BA_1957_0308_2_5">maria mater gratiae</l>
        <l n="6" xml:id="HY_BA_1957_0308_2_6">mater misericordiae</l>
        <l n="7" xml:id="HY_BA_1957_0308_2_7">tu nos ab hoste protege</l>
        <l n="8" xml:id="HY_BA_1957_0308_2_8">et hora mortis suscipe</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0308_3">
        <l n="9" xml:id="HY_BA_1957_0308_3_9">gloria tibi domine</l>
        <l n="10" xml:id="HY_BA_1957_0308_3_10">qui natus es de virgine</l>
        <l n="11" xml:id="HY_BA_1957_0308_3_11">cum patre et almo spiritu</l>
        <l n="12" xml:id="HY_BA_1957_0308_3_12">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>