<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0206">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0206_1">
        <l n="1" xml:id="HY_BA_1957_0206_1_1">optata fulsit praesulis</l>
        <l n="2" xml:id="HY_BA_1957_0206_1_2">lux sacra calimerii</l>
        <l n="3" xml:id="HY_BA_1957_0206_1_3">qui luce splendens nominis</l>
        <l n="4" xml:id="HY_BA_1957_0206_1_4">splendore crevit sanguinis</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0206_2">
        <l n="5" xml:id="HY_BA_1957_0206_2_5">graecis ab oris profugus</l>
        <l n="6" xml:id="HY_BA_1957_0206_2_6">ut sede tuta sisteret</l>
        <l n="7" xml:id="HY_BA_1957_0206_2_7">romae sacrorum principem</l>
        <l n="8" xml:id="HY_BA_1957_0206_2_8">hospes rogat telesphorum</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0206_3">
        <l n="9" xml:id="HY_BA_1957_0206_3_9">sed pulsus inde ab impiis</l>
        <l n="10" xml:id="HY_BA_1957_0206_3_10">effugit atque illinc vagus</l>
        <l n="11" xml:id="HY_BA_1957_0206_3_11">divina qua ducit manus</l>
        <l n="12" xml:id="HY_BA_1957_0206_3_12">ad nostra venit moenia</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0206_4">
        <l n="13" xml:id="HY_BA_1957_0206_4_13">hic fovit illum charitas</l>
        <l n="14" xml:id="HY_BA_1957_0206_4_14">castritiani episcopi</l>
        <l n="15" xml:id="HY_BA_1957_0206_4_15">crevitque sic virtutibus</l>
        <l n="16" xml:id="HY_BA_1957_0206_4_16">successor ut mox fieret</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0206_5">
        <l n="17" xml:id="HY_BA_1957_0206_5_17">sed dum profana numina</l>
        <l n="18" xml:id="HY_BA_1957_0206_5_18">verbo tonante fulminat</l>
        <l n="19" xml:id="HY_BA_1957_0206_5_19">percussus ense barbaro</l>
        <l n="20" xml:id="HY_BA_1957_0206_5_20">ad astra victor evolat</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0206_6">
        <l n="21" xml:id="HY_BA_1957_0206_6_21">putei profundo mergitur</l>
        <l n="22" xml:id="HY_BA_1957_0206_6_22">ut sol in undis occidens</l>
        <l n="23" xml:id="HY_BA_1957_0206_6_23">ut clarior resurgeret</l>
        <l n="24" xml:id="HY_BA_1957_0206_6_24">cruore totus innatat</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0206_7">
        <l n="25" xml:id="HY_BA_1957_0206_7_25">tu christe tanti martyris</l>
        <l n="26" xml:id="HY_BA_1957_0206_7_26">nobis rogatu subveni</l>
        <l n="27" xml:id="HY_BA_1957_0206_7_27">pellatque nostra crimina</l>
        <l n="28" xml:id="HY_BA_1957_0206_7_28">sincera virtus praesulis</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0206_8">
        <l n="29" xml:id="HY_BA_1957_0206_8_29">patri simulque filio</l>
        <l n="30" xml:id="HY_BA_1957_0206_8_30">tibique sancte spiritus</l>
        <l n="31" xml:id="HY_BA_1957_0206_8_31">sicut fuit sit iugiter</l>
        <l n="32" xml:id="HY_BA_1957_0206_8_32">saeclum per omne gloria amen</l>
      </lg>
    </body>
  </text>
</TEI>