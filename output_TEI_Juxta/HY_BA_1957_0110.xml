<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0110">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0110_1">
        <l n="1" xml:id="HY_BA_1957_0110_1_1">praeclara custos virginum</l>
        <l n="2" xml:id="HY_BA_1957_0110_1_2">intacta mater numinis</l>
        <l n="3" xml:id="HY_BA_1957_0110_1_3">caelestis aulae ianua</l>
        <l n="4" xml:id="HY_BA_1957_0110_1_4">spes nostra caeli gaudium</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0110_2">
        <l n="5" xml:id="HY_BA_1957_0110_2_5">inter rubeta lilium</l>
        <l n="6" xml:id="HY_BA_1957_0110_2_6">columba formosissima</l>
        <l n="7" xml:id="HY_BA_1957_0110_2_7">virgo e radice germinans</l>
        <l n="8" xml:id="HY_BA_1957_0110_2_8">nostro medelam vulneri</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0110_3">
        <l n="9" xml:id="HY_BA_1957_0110_3_9">turris draconi impervia</l>
        <l n="10" xml:id="HY_BA_1957_0110_3_10">amica stella naufragis</l>
        <l n="11" xml:id="HY_BA_1957_0110_3_11">tuere nos a fraudibus</l>
        <l n="12" xml:id="HY_BA_1957_0110_3_12">tuaque luce dirige</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0110_4">
        <l n="13" xml:id="HY_BA_1957_0110_4_13">erroris umbras discute</l>
        <l n="14" xml:id="HY_BA_1957_0110_4_14">syrtes dolosas amove</l>
        <l n="15" xml:id="HY_BA_1957_0110_4_15">fluctus tot inter deviis</l>
        <l n="16" xml:id="HY_BA_1957_0110_4_16">tutam reclude semitam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0110_5">
        <l n="17" xml:id="HY_BA_1957_0110_5_17">iesu tibi sit gloria</l>
        <l n="18" xml:id="HY_BA_1957_0110_5_18">qui natus es de virgine</l>
        <l n="19" xml:id="HY_BA_1957_0110_5_19">cum patre et almo spiritu</l>
        <l n="20" xml:id="HY_BA_1957_0110_5_20">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>