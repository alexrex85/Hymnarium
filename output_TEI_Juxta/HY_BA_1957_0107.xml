<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0107">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0107_1">
        <l n="1" xml:id="HY_BA_1957_0107_1_1">apostolorum principem</l>
        <l n="2" xml:id="HY_BA_1957_0107_1_2">germanus andreas sequens</l>
        <l n="3" xml:id="HY_BA_1957_0107_1_3">beat salutis prospero</l>
        <l n="4" xml:id="HY_BA_1957_0107_1_4">truces achaeos nuntio</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0107_2">
        <l n="5" xml:id="HY_BA_1957_0107_2_5">patrae revinctum carcere</l>
        <l n="6" xml:id="HY_BA_1957_0107_2_6">servant in arcto vincula</l>
        <l n="7" xml:id="HY_BA_1957_0107_2_7">poenis acerbis caeditur</l>
        <l n="8" xml:id="HY_BA_1957_0107_2_8">tortor calet vesania</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0107_3">
        <l n="9" xml:id="HY_BA_1957_0107_3_9">discerptus ictu plurimo</l>
        <l n="10" xml:id="HY_BA_1957_0107_3_10">ligno crucis suspenditur</l>
        <l n="11" xml:id="HY_BA_1957_0107_3_11">pergit superstes biduo</l>
        <l n="12" xml:id="HY_BA_1957_0107_3_12">fidem docere caelicam</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0107_4">
        <l n="13" xml:id="HY_BA_1957_0107_4_13">plebea vox attollitur</l>
        <l n="14" xml:id="HY_BA_1957_0107_4_14">carum reposcens numini</l>
        <l n="15" xml:id="HY_BA_1957_0107_4_15">iubetque poenis eximi</l>
        <l n="16" xml:id="HY_BA_1957_0107_4_16">fuso cruentum sanguine</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0107_5">
        <l n="17" xml:id="HY_BA_1957_0107_5_17">festinat ad crucem ferus</l>
        <l n="18" xml:id="HY_BA_1957_0107_5_18">velut solutum carnifex</l>
        <l n="19" xml:id="HY_BA_1957_0107_5_19">hunc orat andreas cruce</l>
        <l n="20" xml:id="HY_BA_1957_0107_5_20">ne se beata detrahat</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0107_6">
        <l n="21" xml:id="HY_BA_1957_0107_6_21">tum frater aegeae pius</l>
        <l n="22" xml:id="HY_BA_1957_0107_6_22">mentem reprendit impiam</l>
        <l n="23" xml:id="HY_BA_1957_0107_6_23">iniusta questus criminis</l>
        <l n="24" xml:id="HY_BA_1957_0107_6_24">tormenta ferre nescium</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0107_7">
        <l n="25" xml:id="HY_BA_1957_0107_7_25">iam nunc cruore barbara</l>
        <l n="26" xml:id="HY_BA_1957_0107_7_26">pascas tyranne pectora</l>
        <l n="27" xml:id="HY_BA_1957_0107_7_27">cruci triumphus callidum</l>
        <l n="28" xml:id="HY_BA_1957_0107_7_28">devicit hostem tartari</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0107_8">
        <l n="29" xml:id="HY_BA_1957_0107_8_29">imploret ergo numinis</l>
        <l n="30" xml:id="HY_BA_1957_0107_8_30">apostolus clementiam</l>
        <l n="31" xml:id="HY_BA_1957_0107_8_31">possimus ut nos consequi</l>
        <l n="32" xml:id="HY_BA_1957_0107_8_32">in fine sancta praemia</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0107_9">
        <l n="33" xml:id="HY_BA_1957_0107_9_33">patri simulque filio</l>
        <l n="34" xml:id="HY_BA_1957_0107_9_34">tibique sancte spiritus</l>
        <l n="35" xml:id="HY_BA_1957_0107_9_35">sicut fuit sit iugiter</l>
        <l n="36" xml:id="HY_BA_1957_0107_9_36">saeclum per omne gloria amen</l>
      </lg>
    </body>
  </text>
</TEI>