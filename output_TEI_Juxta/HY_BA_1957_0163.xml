<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0163">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0163_1">
        <l n="1" xml:id="HY_BA_1957_0163_1_1">regi polorum debitas</l>
        <l n="2" xml:id="HY_BA_1957_0163_1_2">cuncti canamus gratias</l>
        <l n="3" xml:id="HY_BA_1957_0163_1_3">opem tulit qui caelitus</l>
        <l n="4" xml:id="HY_BA_1957_0163_1_4">nostrae favens ecclesiae</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0163_2">
        <l n="5" xml:id="HY_BA_1957_0163_2_5">quae charitatis munere</l>
        <l n="6" xml:id="HY_BA_1957_0163_2_6">bonos alendo recreat</l>
        <l n="7" xml:id="HY_BA_1957_0163_2_7">munita sancto spiritu</l>
        <l n="8" xml:id="HY_BA_1957_0163_2_8">fide coruscans fulgida</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0163_3">
        <l n="9" xml:id="HY_BA_1957_0163_3_9">grex iste carus numini</l>
        <l n="10" xml:id="HY_BA_1957_0163_3_10">nutritus a pastoribus</l>
        <l n="11" xml:id="HY_BA_1957_0163_3_11">vitae perennis pascua</l>
        <l n="12" xml:id="HY_BA_1957_0163_3_12">sumendo dives permanet</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0163_4">
        <l n="13" xml:id="HY_BA_1957_0163_4_13">hunc firmat ad christi fidem</l>
        <l n="14" xml:id="HY_BA_1957_0163_4_14">confessio dionysii</l>
        <l n="15" xml:id="HY_BA_1957_0163_4_15">legem tuendo caelicam</l>
        <l n="16" xml:id="HY_BA_1957_0163_4_16">plebs pascitur credentium</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0163_5">
        <l n="17" xml:id="HY_BA_1957_0163_5_17">petit scelesti praesulem</l>
        <l n="18" xml:id="HY_BA_1957_0163_5_18">sequax arii concio</l>
        <l n="19" xml:id="HY_BA_1957_0163_5_19">templique valvas obsidens</l>
        <l n="20" xml:id="HY_BA_1957_0163_5_20">feros minatur compedes</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0163_6">
        <l n="21" xml:id="HY_BA_1957_0163_6_21">at ille christum deprecans</l>
        <l n="22" xml:id="HY_BA_1957_0163_6_22">insomnis aras protegit</l>
        <l n="23" xml:id="HY_BA_1957_0163_6_23">divina cum fidelibus</l>
        <l n="24" xml:id="HY_BA_1957_0163_6_24">exercet antistes sacra</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0163_7">
        <l n="25" xml:id="HY_BA_1957_0163_7_25">exin comes palatii</l>
        <l n="26" xml:id="HY_BA_1957_0163_7_26">abducit aede praesules</l>
        <l n="27" xml:id="HY_BA_1957_0163_7_27">eusebius dionysius</l>
        <l n="28" xml:id="HY_BA_1957_0163_7_28">diris ligantur vinculis</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0163_8">
        <l n="29" xml:id="HY_BA_1957_0163_8_29">captos precemur sedule</l>
        <l n="30" xml:id="HY_BA_1957_0163_8_30">verbi dei pro nomine</l>
        <l n="31" xml:id="HY_BA_1957_0163_8_31">ut nos beatis siderum</l>
        <l n="32" xml:id="HY_BA_1957_0163_8_32">tandem fruamur gaudiis</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0163_9">
        <l n="33" xml:id="HY_BA_1957_0163_9_33">deo patri sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0163_9_34">eiusque soli filio</l>
        <l n="35" xml:id="HY_BA_1957_0163_9_35">cum spiritu paraclito</l>
        <l n="36" xml:id="HY_BA_1957_0163_9_36">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
</TEI>