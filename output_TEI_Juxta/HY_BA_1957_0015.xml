<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0015">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0015_1">
        <l n="1" xml:id="HY_BA_1957_0015_1_1">audi beata seraphim</l>
        <l n="2" xml:id="HY_BA_1957_0015_1_2">tecumque noster aemulis</l>
        <l n="3" xml:id="HY_BA_1957_0015_1_3">chorus resultet canticis</l>
        <l n="4" xml:id="HY_BA_1957_0015_1_4">hic est quem iesus diligit</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0015_2">
        <l n="5" xml:id="HY_BA_1957_0015_2_5">qui dum magistri in pectore</l>
        <l n="6" xml:id="HY_BA_1957_0015_2_6">somno recumbit mystico</l>
        <l n="7" xml:id="HY_BA_1957_0015_2_7">quiescit instar angeli</l>
        <l n="8" xml:id="HY_BA_1957_0015_2_8">dei fruens amplexibus</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0015_3">
        <l n="9" xml:id="HY_BA_1957_0015_3_9">hic discit ante saecula</l>
        <l n="10" xml:id="HY_BA_1957_0015_3_10">natum unde verbum prodeat</l>
        <l n="11" xml:id="HY_BA_1957_0015_3_11">sinumque matris impleat</l>
        <l n="12" xml:id="HY_BA_1957_0015_3_12">sinum patris non deserens</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0015_4">
        <l n="13" xml:id="HY_BA_1957_0015_4_13">felix ioannes conferas</l>
        <l n="14" xml:id="HY_BA_1957_0015_4_14">nunc clara thabor culmina</l>
        <l n="15" xml:id="HY_BA_1957_0015_4_15">cum dulci iesu pectore</l>
        <l n="16" xml:id="HY_BA_1957_0015_4_16">et narra ubi plus gaudeas</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0015_5">
        <l n="17" xml:id="HY_BA_1957_0015_5_17">iam te mariae filium</l>
        <l n="18" xml:id="HY_BA_1957_0015_5_18">in monte christus nuncupat</l>
        <l n="19" xml:id="HY_BA_1957_0015_5_19">suoque suetum pectori</l>
        <l n="20" xml:id="HY_BA_1957_0015_5_20">in corde matris collocat</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0015_6">
        <l n="21" xml:id="HY_BA_1957_0015_6_21">cui te ioannes comparem</l>
        <l n="22" xml:id="HY_BA_1957_0015_6_22">divina vox te parturit</l>
        <l n="23" xml:id="HY_BA_1957_0015_6_23">ex ore verbi nasceris</l>
        <l n="24" xml:id="HY_BA_1957_0015_6_24">alter mariae filius</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0015_7">
        <l n="25" xml:id="HY_BA_1957_0015_7_25">o virgo dignus virgine</l>
        <l n="26" xml:id="HY_BA_1957_0015_7_26">successor alti nominis</l>
        <l n="27" xml:id="HY_BA_1957_0015_7_27">custos mariae et filius</l>
        <l n="28" xml:id="HY_BA_1957_0015_7_28">tanto nec impar muneri</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0015_8">
        <l n="29" xml:id="HY_BA_1957_0015_8_29">nunc ergo fili virginis</l>
        <l n="30" xml:id="HY_BA_1957_0015_8_30">mariae adauge filios</l>
        <l n="31" xml:id="HY_BA_1957_0015_8_31">sinusque iesu conscie</l>
        <l n="32" xml:id="HY_BA_1957_0015_8_32">nos conde christi in pectore</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0015_9">
        <l n="33" xml:id="HY_BA_1957_0015_9_33">iesu tibi sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0015_9_34">qui natus es de virgine</l>
        <l n="35" xml:id="HY_BA_1957_0015_9_35">cum patre et almo spiritu</l>
        <l n="36" xml:id="HY_BA_1957_0015_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>