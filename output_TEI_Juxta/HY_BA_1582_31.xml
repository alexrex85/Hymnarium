<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_31">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_31_1">
        <l n="1" xml:id="HY_BA_1582_31_1_1">quodcumque vinclis super terram strinxeris</l>
        <l n="2" xml:id="HY_BA_1582_31_1_2">erit in astris religatum fortiter</l>
        <l n="3" xml:id="HY_BA_1582_31_1_3">et quod resolvis in terris arbitrio</l>
        <l n="4" xml:id="HY_BA_1582_31_1_4">erit solutum super coeli radium</l>
        <l n="5" xml:id="HY_BA_1582_31_1_5">in fine mundi iudex erit saeculi</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_31_2">
        <l n="6" xml:id="HY_BA_1582_31_2_6">gloria deo per immensa saecula</l>
        <l n="7" xml:id="HY_BA_1582_31_2_7">sit tibi nate decus et imperium</l>
        <l n="8" xml:id="HY_BA_1582_31_2_8">honor potestas sanctoque spiritui</l>
        <l n="9" xml:id="HY_BA_1582_31_2_9">sit trinitati salus individua</l>
        <l n="10" xml:id="HY_BA_1582_31_2_10">per infinita saecula saeculorum amen</l>
      </lg>
    </body>
  </text>
</TEI>