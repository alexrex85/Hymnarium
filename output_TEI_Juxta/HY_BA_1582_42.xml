<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1582_42">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1582_42_1">
        <l n="1" xml:id="HY_BA_1582_42_1_1">sacri triumphale tui</l>
        <l n="2" xml:id="HY_BA_1582_42_1_2">christi bellator inclyte</l>
        <l n="3" xml:id="HY_BA_1582_42_1_3">quo alma fides et crucis</l>
        <l n="4" xml:id="HY_BA_1582_42_1_4">tropheum vernat praelii</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1582_42_2">
        <l n="5" xml:id="HY_BA_1582_42_2_5">modis canora mysticis</l>
        <l n="6" xml:id="HY_BA_1582_42_2_6">nunc turba laudem concinit</l>
        <l n="7" xml:id="HY_BA_1582_42_2_7">nazari lux vitae decus</l>
        <l n="8" xml:id="HY_BA_1582_42_2_8">apostolorum particeps</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1582_42_3">
        <l n="9" xml:id="HY_BA_1582_42_3_9">petri coronaris fide</l>
        <l n="10" xml:id="HY_BA_1582_42_3_10">paulique dogma nobili</l>
        <l n="11" xml:id="HY_BA_1582_42_3_11">ungente lino praesule</l>
        <l n="12" xml:id="HY_BA_1582_42_3_12">sancto muniris spiritu</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1582_42_4">
        <l n="13" xml:id="HY_BA_1582_42_4_13">celsum haeredem sanguinis</l>
        <l n="14" xml:id="HY_BA_1582_42_4_14">haeredem tanti nominis</l>
        <l n="15" xml:id="HY_BA_1582_42_4_15">pari coronatum fide</l>
        <l n="16" xml:id="HY_BA_1582_42_4_16">christo libasti victimam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1582_42_5">
        <l n="17" xml:id="HY_BA_1582_42_5_17">caelo locans substantiam</l>
        <l n="18" xml:id="HY_BA_1582_42_5_18">aerugo quam non devorat</l>
        <l n="19" xml:id="HY_BA_1582_42_5_19">gentes trahens ad gratiam</l>
        <l n="20" xml:id="HY_BA_1582_42_5_20">sacra talenta duplicans</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1582_42_6">
        <l n="21" xml:id="HY_BA_1582_42_6_21">sic elementum liquidum</l>
        <l n="22" xml:id="HY_BA_1582_42_6_22">fixis calcans vestigiis</l>
        <l n="23" xml:id="HY_BA_1582_42_6_23">reddis ereptos patriae</l>
        <l n="24" xml:id="HY_BA_1582_42_6_24">morti tributos aequoris</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1582_42_7">
        <l n="25" xml:id="HY_BA_1582_42_7_25">his ita gestis inclyte</l>
        <l n="26" xml:id="HY_BA_1582_42_7_26">sancto recisus vertice</l>
        <l n="27" xml:id="HY_BA_1582_42_7_27">coronam insignem ferens</l>
        <l n="28" xml:id="HY_BA_1582_42_7_28">vitae nitescis praemio</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1582_42_8">
        <l n="29" xml:id="HY_BA_1582_42_8_29">vota precantum suscipe</l>
        <l n="30" xml:id="HY_BA_1582_42_8_30">precator o egregie</l>
        <l n="31" xml:id="HY_BA_1582_42_8_31">amator et verbi dei</l>
        <l n="32" xml:id="HY_BA_1582_42_8_32">ac doctor evangelicae</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1582_42_9">
        <l n="33" xml:id="HY_BA_1582_42_9_33">gloria tibi domine</l>
        <l n="34" xml:id="HY_BA_1582_42_9_34">gloria unigenito</l>
        <l n="35" xml:id="HY_BA_1582_42_9_35">una cum sancto spiritu</l>
        <l n="36" xml:id="HY_BA_1582_42_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>