<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0162">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0162_1">
        <l n="1" xml:id="HY_BA_1957_0162_1_1">sacri triumphales tui</l>
        <l n="2" xml:id="HY_BA_1957_0162_1_2">dux magne palmas dicimus</l>
        <l n="3" xml:id="HY_BA_1957_0162_1_3">quod arma virtus et crucis</l>
        <l n="4" xml:id="HY_BA_1957_0162_1_4">vernet trophaeum praelii</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0162_2">
        <l n="5" xml:id="HY_BA_1957_0162_2_5">modis canora mysticis</l>
        <l n="6" xml:id="HY_BA_1957_0162_2_6">nunc turba laudem concinit</l>
        <l n="7" xml:id="HY_BA_1957_0162_2_7">nazare lux vitae decus</l>
        <l n="8" xml:id="HY_BA_1957_0162_2_8">apostolorum particeps</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0162_3">
        <l n="9" xml:id="HY_BA_1957_0162_3_9">petri coronaris fide</l>
        <l n="10" xml:id="HY_BA_1957_0162_3_10">sacroque pauli dogmate</l>
        <l n="11" xml:id="HY_BA_1957_0162_3_11">ungente lino praesule</l>
        <l n="12" xml:id="HY_BA_1957_0162_3_12">muniris almo spiritu</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0162_4">
        <l n="13" xml:id="HY_BA_1957_0162_4_13">celsum sequacem praelii</l>
        <l n="14" xml:id="HY_BA_1957_0162_4_14">tanti sequacem nominis</l>
        <l n="15" xml:id="HY_BA_1957_0162_4_15">pari coronatum fide</l>
        <l n="16" xml:id="HY_BA_1957_0162_4_16">christo sacrasti victimam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0162_5">
        <l n="17" xml:id="HY_BA_1957_0162_5_17">caelo locans substantiam</l>
        <l n="18" xml:id="HY_BA_1957_0162_5_18">aerugo quam non devorat</l>
        <l n="19" xml:id="HY_BA_1957_0162_5_19">gentes trahens ad gratiam</l>
        <l n="20" xml:id="HY_BA_1957_0162_5_20">talenta sacra duplicans</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0162_6">
        <l n="21" xml:id="HY_BA_1957_0162_6_21">sic fluctuantes vortices</l>
        <l n="22" xml:id="HY_BA_1957_0162_6_22">fixis premens vestigiis</l>
        <l n="23" xml:id="HY_BA_1957_0162_6_23">donas ademptos patriae</l>
        <l n="24" xml:id="HY_BA_1957_0162_6_24">morti tributos aequoris</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0162_7">
        <l n="25" xml:id="HY_BA_1957_0162_7_25">his rebus actis inclyte</l>
        <l n="26" xml:id="HY_BA_1957_0162_7_26">sancto recisus vertice</l>
        <l n="27" xml:id="HY_BA_1957_0162_7_27">caeli coronam praeferens</l>
        <l n="28" xml:id="HY_BA_1957_0162_7_28">vitae nitescis praemio</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0162_8">
        <l n="29" xml:id="HY_BA_1957_0162_8_29">attende vota supplicum</l>
        <l n="30" xml:id="HY_BA_1957_0162_8_30">potens precator numinis</l>
        <l n="31" xml:id="HY_BA_1957_0162_8_31">amator et verbi dei</l>
        <l n="32" xml:id="HY_BA_1957_0162_8_32">legisque doctor caelicae</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0162_9">
        <l n="33" xml:id="HY_BA_1957_0162_9_33">deo patri sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0162_9_34">eiusque soli filio</l>
        <l n="35" xml:id="HY_BA_1957_0162_9_35">cum spiritu paraclito</l>
        <l n="36" xml:id="HY_BA_1957_0162_9_36">nunc et per omne saeculum amen</l>
      </lg>
    </body>
  </text>
</TEI>