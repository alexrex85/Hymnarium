<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0208">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0208_1">
        <l n="1" xml:id="HY_BA_1957_0208_1_1">apostolorum supparem</l>
        <l n="2" xml:id="HY_BA_1957_0208_1_2">laurentium archidiaconum</l>
        <l n="3" xml:id="HY_BA_1957_0208_1_3">pari corona martyrum</l>
        <l n="4" xml:id="HY_BA_1957_0208_1_4">romana sacravit fides</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0208_2">
        <l n="5" xml:id="HY_BA_1957_0208_2_5">xystum sequens hic martyrem</l>
        <l n="6" xml:id="HY_BA_1957_0208_2_6">responsa vatis rettulit</l>
        <l n="7" xml:id="HY_BA_1957_0208_2_7">moerere fili desine</l>
        <l n="8" xml:id="HY_BA_1957_0208_2_8">sequere me post triduum</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0208_3">
        <l n="9" xml:id="HY_BA_1957_0208_3_9">nec territus poenae metu</l>
        <l n="10" xml:id="HY_BA_1957_0208_3_10">haeres futurus sanguinis</l>
        <l n="11" xml:id="HY_BA_1957_0208_3_11">spectavit obtutu pio</l>
        <l n="12" xml:id="HY_BA_1957_0208_3_12">quod ipse mox persolveret</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0208_4">
        <l n="13" xml:id="HY_BA_1957_0208_4_13">iam tunc in illo martyre</l>
        <l n="14" xml:id="HY_BA_1957_0208_4_14">egit triumphum martyris</l>
        <l n="15" xml:id="HY_BA_1957_0208_4_15">successor aequus syngrapham</l>
        <l n="16" xml:id="HY_BA_1957_0208_4_16">vocis tenens et sanguinis</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0208_5">
        <l n="17" xml:id="HY_BA_1957_0208_5_17">post triduum iussus tamen</l>
        <l n="18" xml:id="HY_BA_1957_0208_5_18">census sacratos prodere</l>
        <l n="19" xml:id="HY_BA_1957_0208_5_19">spondet pie nec abnuit</l>
        <l n="20" xml:id="HY_BA_1957_0208_5_20">addens dolum victoriae</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0208_6">
        <l n="21" xml:id="HY_BA_1957_0208_6_21">spectaculum pulcherrimum</l>
        <l n="22" xml:id="HY_BA_1957_0208_6_22">egena cogit agmina</l>
        <l n="23" xml:id="HY_BA_1957_0208_6_23">inopesque monstrans praedicat</l>
        <l n="24" xml:id="HY_BA_1957_0208_6_24">hi sunt opes ecclesiae</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0208_7">
        <l n="25" xml:id="HY_BA_1957_0208_7_25">lucro piorum perpetes</l>
        <l n="26" xml:id="HY_BA_1957_0208_7_26">inopes profecto sunt opes</l>
        <l n="27" xml:id="HY_BA_1957_0208_7_27">avarus illusus dolet</l>
        <l n="28" xml:id="HY_BA_1957_0208_7_28">flammas et ultrices parat</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0208_8">
        <l n="29" xml:id="HY_BA_1957_0208_8_29">fugit perustus carnifex</l>
        <l n="30" xml:id="HY_BA_1957_0208_8_30">suisque cedit ignibus</l>
        <l n="31" xml:id="HY_BA_1957_0208_8_31">versate me martyr vocat</l>
        <l n="32" xml:id="HY_BA_1957_0208_8_32">vorate coctum si lubet</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0208_9">
        <l n="33" xml:id="HY_BA_1957_0208_9_33">patri simulque filio</l>
        <l n="34" xml:id="HY_BA_1957_0208_9_34">tibique sancte spiritus</l>
        <l n="35" xml:id="HY_BA_1957_0208_9_35">sicut fuit sit iugiter</l>
        <l n="36" xml:id="HY_BA_1957_0208_9_36">saeclum per omne gloria amen</l>
      </lg>
    </body>
  </text>
</TEI>