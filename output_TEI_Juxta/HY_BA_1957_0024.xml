<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0024">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0024_1">
        <l n="1" xml:id="HY_BA_1957_0024_1_1">vexilla regis prodeunt</l>
        <l n="2" xml:id="HY_BA_1957_0024_1_2">fulget crucis mysterium</l>
        <l n="3" xml:id="HY_BA_1957_0024_1_3">qua vita mortem pertulit</l>
        <l n="4" xml:id="HY_BA_1957_0024_1_4">et morte vitam reddidit</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0024_2">
        <l n="5" xml:id="HY_BA_1957_0024_2_5">figunt cruenti numinis</l>
        <l n="6" xml:id="HY_BA_1957_0024_2_6">clavi manus vestigia</l>
        <l n="7" xml:id="HY_BA_1957_0024_2_7">redemptionis gratia</l>
        <l n="8" xml:id="HY_BA_1957_0024_2_8">hic immolatur hostia</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0024_3">
        <l n="9" xml:id="HY_BA_1957_0024_3_9">post vulneratus impiae</l>
        <l n="10" xml:id="HY_BA_1957_0024_3_10">mucrone diro lanceae</l>
        <l n="11" xml:id="HY_BA_1957_0024_3_11">ut nos lavaret crimine</l>
        <l n="12" xml:id="HY_BA_1957_0024_3_12">manavit unda et sanguine</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0024_4">
        <l n="13" xml:id="HY_BA_1957_0024_4_13">impleta sunt quae concinit</l>
        <l n="14" xml:id="HY_BA_1957_0024_4_14">david fideli carmine</l>
        <l n="15" xml:id="HY_BA_1957_0024_4_15">dicendo nationibus</l>
        <l n="16" xml:id="HY_BA_1957_0024_4_16">regnavit a ligno deus</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0024_5">
        <l n="17" xml:id="HY_BA_1957_0024_5_17">arbor decora et fulgida</l>
        <l n="18" xml:id="HY_BA_1957_0024_5_18">ornata regis purpura</l>
        <l n="19" xml:id="HY_BA_1957_0024_5_19">electa digno stipite</l>
        <l n="20" xml:id="HY_BA_1957_0024_5_20">tam sancta membra tangere</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0024_6">
        <l n="21" xml:id="HY_BA_1957_0024_6_21">beata cuius brachiis</l>
        <l n="22" xml:id="HY_BA_1957_0024_6_22">salus pependit saeculi</l>
        <l n="23" xml:id="HY_BA_1957_0024_6_23">statera facta est corporis</l>
        <l n="24" xml:id="HY_BA_1957_0024_6_24">tulitque praedam tartari</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0024_7">
        <l n="25" xml:id="HY_BA_1957_0024_7_25">o crux ave spes unica</l>
        <l n="26" xml:id="HY_BA_1957_0024_7_26">hoc passionis tempore</l>
        <l n="27" xml:id="HY_BA_1957_0024_7_27">piis adauge gratiam</l>
        <l n="28" xml:id="HY_BA_1957_0024_7_28">reisque dele crimina</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0024_8">
        <l n="29" xml:id="HY_BA_1957_0024_8_29">te summa caeli trinitas</l>
        <l n="30" xml:id="HY_BA_1957_0024_8_30">collaudet omnis spiritus</l>
        <l n="31" xml:id="HY_BA_1957_0024_8_31">quos per crucis mysterium</l>
        <l n="32" xml:id="HY_BA_1957_0024_8_32">salvas tuere iugiter amen</l>
      </lg>
    </body>
  </text>
</TEI>