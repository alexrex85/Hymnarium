<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="HY_BA_1957_0116">
  <text>
    <body>
      <lg n="1" xml:id="HY_BA_1957_0116_1">
        <l n="1" xml:id="HY_BA_1957_0116_1_1">piis sacratum vocibus</l>
        <l n="2" xml:id="HY_BA_1957_0116_1_2">diem colamus agathae</l>
        <l n="3" xml:id="HY_BA_1957_0116_1_3">in quo tyrannum conterens</l>
        <l n="4" xml:id="HY_BA_1957_0116_1_4">palmam tulit certaminis</l>
      </lg>
      <lg n="2" xml:id="HY_BA_1957_0116_2">
        <l n="5" xml:id="HY_BA_1957_0116_2_5">cum quintianus insulam</l>
        <l n="6" xml:id="HY_BA_1957_0116_2_6">regit sicanam virginis</l>
        <l n="7" xml:id="HY_BA_1957_0116_2_7">amore captus innubae</l>
        <l n="8" xml:id="HY_BA_1957_0116_2_8">frendere coepit invidus</l>
      </lg>
      <lg n="3" xml:id="HY_BA_1957_0116_3">
        <l n="9" xml:id="HY_BA_1957_0116_3_9">impurus ignis efferam</l>
        <l n="10" xml:id="HY_BA_1957_0116_3_10">succendit iram pectoris</l>
        <l n="11" xml:id="HY_BA_1957_0116_3_11">deo dicatam virginem</l>
        <l n="12" xml:id="HY_BA_1957_0116_3_12">diro furore ut perderet</l>
      </lg>
      <lg n="4" xml:id="HY_BA_1957_0116_4">
        <l n="13" xml:id="HY_BA_1957_0116_4_13">tentat puellam crimine</l>
        <l n="14" xml:id="HY_BA_1957_0116_4_14">foedata turpi foemina</l>
        <l n="15" xml:id="HY_BA_1957_0116_4_15">at quae subegit tartarum</l>
        <l n="16" xml:id="HY_BA_1957_0116_4_16">invicta vicit foeminam</l>
      </lg>
      <lg n="5" xml:id="HY_BA_1957_0116_5">
        <l n="17" xml:id="HY_BA_1957_0116_5_17">hortatur inde martyrem</l>
        <l n="18" xml:id="HY_BA_1957_0116_5_18">praeses doloris impotens</l>
        <l n="19" xml:id="HY_BA_1957_0116_5_19">ut ignibus colat deos</l>
        <l n="20" xml:id="HY_BA_1957_0116_5_20">nives pudoris execrans</l>
      </lg>
      <lg n="6" xml:id="HY_BA_1957_0116_6">
        <l n="21" xml:id="HY_BA_1957_0116_6_21">sed nil valens insania</l>
        <l n="22" xml:id="HY_BA_1957_0116_6_22">mamma resecta virginem</l>
        <l n="23" xml:id="HY_BA_1957_0116_6_23">interritam flagrantibus</l>
        <l n="24" xml:id="HY_BA_1957_0116_6_24">ardet necare testulis</l>
      </lg>
      <lg n="7" xml:id="HY_BA_1957_0116_7">
        <l n="25" xml:id="HY_BA_1957_0116_7_25">cuius medendis artubus</l>
        <l n="26" xml:id="HY_BA_1957_0116_7_26">clemens adest apostolus</l>
        <l n="27" xml:id="HY_BA_1957_0116_7_27">sermone curans vulnera</l>
        <l n="28" xml:id="HY_BA_1957_0116_7_28">quae carnifex inflixerat</l>
      </lg>
      <lg n="8" xml:id="HY_BA_1957_0116_8">
        <l n="29" xml:id="HY_BA_1957_0116_8_29">hinc ad sepulcrum pervolat</l>
        <l n="30" xml:id="HY_BA_1957_0116_8_30">amictus albis angelus</l>
        <l n="31" xml:id="HY_BA_1957_0116_8_31">mentemque sanctam praedicat</l>
        <l n="32" xml:id="HY_BA_1957_0116_8_32">patriae salutem plurimam</l>
      </lg>
      <lg n="9" xml:id="HY_BA_1957_0116_9">
        <l n="33" xml:id="HY_BA_1957_0116_9_33">iesu tibi sit gloria</l>
        <l n="34" xml:id="HY_BA_1957_0116_9_34">qui natus es de virgine</l>
        <l n="35" xml:id="HY_BA_1957_0116_9_35">cum patre et almo spiritu</l>
        <l n="36" xml:id="HY_BA_1957_0116_9_36">in sempiterna saecula amen</l>
      </lg>
    </body>
  </text>
</TEI>