    <front>

      <p type="notae">Sancti Dionysii Episcopi et Confessoris, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Regi polorum debitas</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_1_1">Regi polorum debitas</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_1_2">cuncti canamus gratias,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_1_3">opem tulit qui caelitus</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_1_4">nostrae favens Ecclesiae;</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_2_5">Quae charitatis munere</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_2_6">Bonos alendo recreat,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_2_7">munita sancto Spiritu,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_2_8">fide coruscans fulgida.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_3_9">Grex iste carus Numini,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_3_10">nutritus a pastoribus,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_3_11">vitae perennis pascua</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_3_12">sumendo dives permanet.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_4_13">Hunc firmat ad Christi fidem</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_4_14">confessio Dionysii;</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_4_15">legem tuendo caelicam</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_4_16">plebs pascitur credentium.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_5_17">Petit scelesti praesulem</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_5_18">sequax Arii concio;</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_5_19">templique valvas obsidens</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_5_20">feros minatur compedes.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_6_21">At ille Christum deprecans,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_6_22">insomnis aras protegit;</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_6_23">divina cum fidelibus</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_6_24">exercet antistes sacra.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_7_25">Exin comes palatii</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_7_26">abducit aede praesules;</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_7_27">Eusebius, Dionysius</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_7_28">diris ligantur vinculis.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_8_29">Captos precemur sedule</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_8_30">Verbi Dei pro nomine,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_8_31">ut nos beatis siderum</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_8_32">tandem fruamur gaudiis.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0163_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0163_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

