    <body>

      <head type="incipit">Iam Christe sol iustitiae</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1582_18_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1582_18_1_1">Iam Christe sol iustitiae,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1582_18_1_2">mentis dehiscant tenebrae,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1582_18_1_3">virtutum ut lux redeat</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1582_18_1_4">terris diem dum reparas.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1582_18_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1582_18_2_5">Da tempus acceptabile,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1582_18_2_6">et poenitens cor tribue:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1582_18_2_7">convertat ut benignitas,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1582_18_2_8">quos longa suffert pietas.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1582_18_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1582_18_3_9">Quiddamque poenitentiae,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1582_18_3_10">da ferre, licet grandium,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1582_18_3_11">maiore tuo munere,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1582_18_3_12">quod demptio sit criminum.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1582_18_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1582_18_4_13">Dies venit dies tua,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1582_18_4_14">in qua reflorent omnia:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1582_18_4_15">laetemur in hac, ad tuam,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1582_18_4_16">per hanc reducti gratiam.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1582_18_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1582_18_5_17">Te rerum universitas,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1582_18_5_18">clemens adorat Trinitas:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1582_18_5_19">et mox novi per veniam,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1582_18_5_20">novum canamus canticum. Amen.</l>
      </lg>

    </body>

