      <head type="incipit">Quodcumque vinclis super terram strinxeris</head>

      <lg n="1" type="pentastichon_iambicum" xml:id="HY_BA_1582_31_1">
        <l n="1" type="trimeter_iambicus" xml:id="HY_BA_1582_31_1_1">Quodcumque vinclis super terram strinxeris,</l>
        <l n="2" type="trimeter_iambicus" xml:id="HY_BA_1582_31_1_2">erit in astris religatum fortiter:</l>
        <l n="3" type="trimeter_iambicus" xml:id="HY_BA_1582_31_1_3">et quod resolvis in terris arbitrio,</l>
        <l n="4" type="trimeter_iambicus" xml:id="HY_BA_1582_31_1_4">erit solutum super coeli radium.</l>
        <l n="5" type="trimeter_iambicus" xml:id="HY_BA_1582_31_1_5">In fine mundi iudex erit saeculi.</l>
      </lg>
      <lg n="2" type="pentastichon_iambicum" xml:id="HY_BA_1582_31_2">
        <l n="6" type="trimeter_iambicus" xml:id="HY_BA_1582_31_2_6">Gloria Deo per immensa saecula,</l>
        <l n="7" type="trimeter_iambicus" xml:id="HY_BA_1582_31_2_7">sit tibi, Nate, decus, et imperium,</l>
        <l n="8" type="trimeter_iambicus" xml:id="HY_BA_1582_31_2_8">honor, potestas, Sanctoque Spiritui,</l>
        <l n="9" type="trimeter_iambicus" xml:id="HY_BA_1582_31_2_9">sit Trinitati salus individua</l>
        <l n="10" type="trimeter_iambicus" xml:id="HY_BA_1582_31_2_10">per infinita saecula saeculorum. Amen.</l>
      </lg>

    </body>

