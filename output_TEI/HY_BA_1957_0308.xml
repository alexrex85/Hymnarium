    <body>

      <head type="incipit">Memento salutis Auctor</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0308_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_1_1">Memento, salutis Auctor,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_1_2">quod nostri quondam corporis</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_1_3">ex illibata Virgine</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_1_4">nascendo formam sumpseris.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0308_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_2_5">Maria, Mater gratiae,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_2_6">Mater misericordiae,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_2_7">tu nos ab hoste protege,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_2_8">et hora mortis suscipe.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0308_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_3_9">Gloria tibi, Domine,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_3_10">qui natus es de Virgine,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_3_11">cum Patre et almo Spiritu</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0308_3_12">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

