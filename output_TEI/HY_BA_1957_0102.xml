    <body>

      <head type="incipit">Custos preces mortalium</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0102_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_1_1">Custos, preces mortalium</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_1_2">audi canoras, Angele,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_1_3">quos magnus orbis Conditor</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_1_4">tuae dedit custodiae.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0102_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_2_5">Nos saevientis igneo</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_2_6">draconis ore libera,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_2_7">nostrum genus qui noxiae</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_2_8">fructu fefellit arboris.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0102_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_3_9">Si quando tentet devium</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_3_10">decepta planta tramitem,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_3_11">humana caeli dirige</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_3_12">ad semitam vestigia.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0102_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_4_13">Momenta nostri singula</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_4_14">defende, tutor Spiritus,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_4_15">et deserentem corpora</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_4_16">astris repone patriis.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0102_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_5_17">Deo Patri sit gloria,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_5_18">eiusque soli Filio,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_5_19">cum Spiritu Paraclito</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0102_5_20">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

