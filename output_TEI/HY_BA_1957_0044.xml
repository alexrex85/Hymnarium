    <front>

      <p type="notae">In Festo Sacratissimi Cordis Iesu, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Summi Parentis Filio</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_1_1">Summi Parentis Filio,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_1_2">Patri futuri saeculi,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_1_3">pacis beatae Principi</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_1_4">promamus ore canticum;</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_2_5">Qui charitatis victima</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_2_6">Verbum Dei factum caro</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_2_7">mortale periturum genus</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_2_8">fuso redemit sanguine.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_3_9">Volens ferali ab arbore</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_3_10">en pendet Agnus innocens:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_3_11">animamque magnam devovet,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_3_12">peccata multorum ferens.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_4_13">Manus pedesque vulnere</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_4_14">grandi cruentum lanceae</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_4_15">late terebrat saeviens</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_4_16">immane in exsanguem furor.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_5_17">Mortale iam chirographum,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_5_18">Christo litante, scinditur,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_5_19">sanctoque pacis foedere</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_5_20">beata iam sedes patet.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_6_21">Heu quantus ardor, quantaque</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_6_22">vis Iesum amoris impulit,</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_6_23">ut dira passus sanguine</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_6_24">poenas nocentum solveret,</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_7_25">Iramque Patris vindicem</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_7_26">nostri misertus flecteret</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_7_27">una expiandis omnium</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_7_28">oblata noxis hostia!</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_8_29">O Iesu, id unus potes,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_8_30">largitor alme, desuper</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_8_31">immitte tu tepentibus</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_8_32">amoris ignem cordibus.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0044_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0044_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

