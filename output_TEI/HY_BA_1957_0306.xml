    <front>

      <p type="notae">In natali unius Matronae, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Ancilla Christi nobilis</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0306_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_1_1">Ancilla Christi nobilis</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_1_2">culpaeque pura noxiae,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_1_3">despexit orbis commoda,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_1_4">stellantis ardens patriae.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0306_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_2_5">Fide flagrabat, igneo</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_2_6">succensa amore Numinis,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_2_7">signis refulgens plurimis,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_2_8">caeli potitur praemiis.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0306_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_3_9">Ex valle tristi flentium,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_3_10">vinclis soluta corporis,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_3_11">ad astra pergens, gaudia</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_3_12">nunc possidet caelestia.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0306_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_4_13">Uni Deo sit gloria,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_4_14">huius rogatu qui pius,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_4_15">vitae peracto termino,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0306_4_16">nos iungat axis civibus. Amen.</l>
      </lg>

    </body>

