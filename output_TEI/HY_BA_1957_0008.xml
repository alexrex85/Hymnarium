  <text>

    <front>

      <p type="notae">In Dominicis et Feriis communibus, ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Deus Creator omnium</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_1_1">Deus, Creator omnium,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_1_2">polique Rector, vestiens</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_1_3">diem decoro lumine,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_1_4">noctem soporis gratia,</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_2_5">artus solutos ut quies</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_2_6">reddat laboris usui</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_2_7">mentesque fessas allevet,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_2_8">luctusque solvat anxios;</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_3_9">grates, peracto iam die,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_3_10">et, noctis exortu, preces,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_3_11">voti reos ut adiuves,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_3_12">hymnum canentes solvimus.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_4_13">Te cordis ima concinant,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_4_14">te vox sonora concrepet,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_4_15">te diligat castus amor,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_4_16">te mens adoret sobria;</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_5_17">ut, cum profunda clauserit</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_5_18">diem caligo noctium,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_5_19">fides tenebras nesciat,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_5_20">et nox fide reluceat.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_6_21">Dormire mentem ne sinas,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_6_22">dormire culpa noverit:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_6_23">castos fides refrigerans</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_6_24">somni vaporem temperet.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_7_25">Exuta sensu lubrico</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_7_26">te cordis alta somnient,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_7_27">ne hostis invidi dolo</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_7_28">pavor quietos suscitet.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_8_29">Christum rogemus et Patrem,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_8_30">Christi Patrisque Spiritum,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_8_31">unum potens per omnia,</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_8_32">fove precantes, Trinitas.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0008_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0008_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

