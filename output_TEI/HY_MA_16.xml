    <front>

      <p type="notae">Sancti Georgii</p>

    </front>

    <body>

      <head type="incipit">Gesta sanctorum martyrum</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_16_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_16_1_1">Gesta sanctorum martyrum:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_16_1_2">meminisse iocundum est:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_16_1_3">et in eorum laudibus:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_16_1_4">Deo canere gloriam.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_16_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_16_2_5">Georgius Christi miles:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_16_2_6">hortus est Capadotiae:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_16_2_7">qui vana mundi respuit:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_16_2_8">mercatus est caelestia.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_16_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_16_3_9">Pecuniam quam detulerat:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_16_3_10">propter honorem fragilem:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_16_3_11">fide repletus Domini:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_16_3_12">stipem dedit pauperibus.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_16_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_16_4_13">Tunc compulsus a principe:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_16_4_14">saxis vota persolvere:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_16_4_15">quos ille per fidem Christi:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_16_4_16">profundum mersit abyssi.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_16_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_16_5_17">Ira accensus tyrannus:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_16_5_18">poenam invexit martyri:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_16_5_19">flagella saeva, carceres:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_16_5_20">seras sive sartagines.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_MA_16_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_MA_16_6_21">Quos ille non contremuit:</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_MA_16_6_22">confortatus a Domino:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_MA_16_6_23">sed magis in populo:</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_MA_16_6_24">fructus divinos intulit.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_MA_16_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_MA_16_7_25">Reginam Alexandriam:</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_MA_16_7_26">vocavit ad martyrium:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_MA_16_7_27">contempsit mundi thesauros:</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_MA_16_7_28">Dei coronam meruit.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_MA_16_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_MA_16_8_29">Bis ternis annis et uno:</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_MA_16_8_30">triumphat mundi principem:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_MA_16_8_31">cervice caesa gladio:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_MA_16_8_32">migravit ad caelestia.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_MA_16_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_MA_16_9_33">Gloria tibi Domine:</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_MA_16_9_34">gloria Unigenito:</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_MA_16_9_35">una cum sancto Spiritu:</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_MA_16_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

