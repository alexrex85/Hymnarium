    <front>

      <p type="notae">Sanctae Agathae Virginis et Martyris, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Agathae sacrae virginis</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1582_34_1_1">Agathae sacrae virginis,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1582_34_1_2">diem festum recolimus:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1582_34_1_3">in quo tyrannum superans,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1582_34_1_4">palmam tulit martyrii.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1582_34_2_5">Quintianus tunc tyrannus,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1582_34_2_6">consularis Siciliae:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1582_34_2_7">audiens famam virginis,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1582_34_2_8">frendere coepit invidus.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1582_34_3_9">Vitiorum affectibus,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1582_34_3_10">mentem vexabat invidam:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1582_34_3_11">Deo dicatam virginem,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1582_34_3_12">diro furore ut perderet.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1582_34_4_13">Statim adsunt miserrimi,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1582_34_4_14">eius volentes pandere:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1582_34_4_15">religionem solidam,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1582_34_4_16">quam tenet ab infantia.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1582_34_5_17">Sisti iubet tunc martyrem,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1582_34_5_18">suis pro tribunalibus:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1582_34_5_19">eamque sic alloquitur,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1582_34_5_20">ut diis cervicem flecteret.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1582_34_6_21">Sed nil valens insania,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1582_34_6_22">in mammam torquet virginem:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1582_34_6_23">testas et acutissimas,</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1582_34_6_24">igni succensas adhibet.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1582_34_7_25">Cuius medendis artubus,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1582_34_7_26">sanctus adest Apostolus:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1582_34_7_27">verbo qui curat vulnera,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1582_34_7_28">quae carnifex infixerat.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1582_34_8_29">Hinc ad sepulchrum advenit,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1582_34_8_30">amictus albis iuvenis:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1582_34_8_31">mentemque sanctam praedicat,</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1582_34_8_32">patriae salutem plurimam.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1582_34_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1582_34_9_33">Gloria tibi Domine,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1582_34_9_34">gloria Unigenito,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1582_34_9_35">una cum sancto Spiritu,</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1582_34_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

