    <front>

      <p type="notae">In natali Sancti Andreae Apostoli</p>

    </front>

    <body>

      <head type="incipit">Post Petrum primum principem</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_02_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_02_1_1">Post Petrum primum principem:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_02_1_2">Andreas apostolus:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_02_1_3">salutis verbum praedicans:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_02_1_4">in Achaia provintia.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_02_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_02_2_5">Captus in Patra oppido:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_02_2_6">traditur diro carceri:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_02_2_7">ferali poena ceditur:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_02_2_8">tortor callet vesania.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_02_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_02_3_9">Dilaniatis ictibus:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_02_3_10">ligno crucis suspenditur:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_02_3_11">biduo vivens non cessat:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_02_3_12">fidem docere populum.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_02_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_02_4_13">Clamor plebis attollitur:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_02_4_14">carus Deo exposcitur:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_02_4_15">reddi iustus et innocens:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_02_4_16">sanctus et bonus quaeritur.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_02_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_02_5_17">Fallax ad patibulum:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_02_5_18">quasi ad solvendum properat:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_02_5_19">devotus martyr in poenis:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_02_5_20">orat ne artioribus.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_MA_02_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_MA_02_6_21">Loris resolvat impius:</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_MA_02_6_22">divinis indeptus muniis:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_MA_02_6_23">frater instigat iurgiis:</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_MA_02_6_24">iustisque quaerimoniis.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_MA_02_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_MA_02_7_25">Eant tecum quae tua sunt:</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_MA_02_7_26">Egeatha durissime:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_MA_02_7_27">completa eius passio:</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_MA_02_7_28">devicto hoste callido.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_MA_02_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_MA_02_8_29">Imploret ergo meritis:</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_MA_02_8_30">suis pro nostris actibus:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_MA_02_8_31">ut mereamur consequi:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_MA_02_8_32">sancta in fine premia.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_MA_02_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_MA_02_9_33">Gloria tibi Domine:</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_MA_02_9_34">gloria Unigenito:</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_MA_02_9_35">una cum sancto Spiritu:</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_MA_02_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

