      <p type="notae">Dominica VI Adventus, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Praesentationis Beatae Mariae Virginis, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Purificationis Beatae Mariae Virginis, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Annunciationis Beatae Mariae Virginis, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Beatae Mariae Virginis de Monte Carmelo, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Sanctae Mariae ad Nives, ad Laudes et ad Vesperas</p>
      <p type="notae">In Nativitate Beatae Mariae Virginis, ad Laudes et ad Vesperas</p>
      <p type="notae">Sanctissimi Nominis Beatae Mariae Virginis, ad Laudes et ad Vesperas</p>
      <p type="notae">Officium Beatae Mariae Virginis, ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Mysterium Ecclesiae</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_1_1">Mysterium Ecclesiae!</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_1_2">Hymnum Christo referimus,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_1_3">quem genuit Puerpera,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_1_4">Verbum Patris in Filio.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_2_5">Sola in sexu foemina</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_2_6">electa es in saeculo,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_2_7">quae meruisti Dominum</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_2_8">sanctum portare in utero.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_3_9">Vates antiqui temporis</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_3_10">praedixerat, quod factum est,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_3_11">quia virgo conciperet</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_3_12">et pareret Emmanuel.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_4_13">Mysterium hoc magnum est,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_4_14">Mariae quod concessum est,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_4_15">ut Deum, per quem omnia,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_4_16">ex se videret progredi.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_5_17">Vere gratia plena es,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_5_18">et gloriosa permanes;</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_5_19">quia ex te natus est Christus,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_5_20">per quem facta sunt omnia.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_6_21">Pastores, qui audierant</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_6_22">cantari Deo gloriam,</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_6_23">cucurrerunt in Bethlehem</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_6_24">natum videre Dominum.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_7_25">Sic Magi ab ortu solis,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_7_26">per sideris indicium,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_7_27">portantes typum gentium,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_7_28">primi obtulerunt munera.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_8_29">Rogemus ergo, populi,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_8_30">Dei Matrem et Virginem,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_8_31">ut ipsa nobis impetret</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_8_32">pacem et indulgentiam.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0012_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_9_33">Iesu, tibi sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_9_34">qui natus es de Virgine,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_9_35">cum Patre et almo Spiritu</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0012_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

