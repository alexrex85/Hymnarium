    <front>

      <p type="notae">Commune Dominicarum. Ad Matutinum</p>

    </front>

    <body>

      <head type="incipit">Splendor paternae gloriae</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_34_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_34_1_1">Splendor paternae gloriae:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_34_1_2">de luce lucem proferens:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_34_1_3">lux lucis, et fons luminis:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_34_1_4">dies dierum illuminans.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_34_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_34_2_5">Verusque sol inlabere:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_34_2_6">micans nitore perpeti:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_34_2_7">iubarque sancti Spiritus:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_34_2_8">infunde nostris sensibus.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_34_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_34_3_9">Votis vocemus et Patrem:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_34_3_10">Patrem perennis gloriae:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_34_3_11">Pater potentis gratiae:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_34_3_12">culpam releget lubricam.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_34_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_34_4_13">Informet actus strenuos:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_34_4_14">dentem retundat invidi:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_34_4_15">casus secundet asperos:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_34_4_16">donet gerendi gratiam.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_34_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_34_5_17">Mentem gubernet, et regat:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_34_5_18">casto fideli corpore:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_34_5_19">fides calore ferveat:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_34_5_20">fraudis venena nesciat.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_MA_34_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_MA_34_6_21">Christusque nobis sit cibus:</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_MA_34_6_22">potusque noster sit fides:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_MA_34_6_23">laeti bibamus sobriam:</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_MA_34_6_24">ebrietatem spiritus.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_MA_34_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_MA_34_7_25">Laetus dies hic transeat:</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_MA_34_7_26">pudor sit ut diluculum:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_MA_34_7_27">fides velut meridies:</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_MA_34_7_28">crepusculum mens nesciat.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_MA_34_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_MA_34_8_29">Aurora cursus provehat:</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_MA_34_8_30">aurora totus prodeat:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_MA_34_8_31">in Patre totus Filius:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_MA_34_8_32">et totus in Verbo Pater.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_MA_34_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_MA_34_9_33">Gloria tibi, Domine:</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_MA_34_9_34">gloria Unigenito:</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_MA_34_9_35">una cum sancto Spiritu:</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_MA_34_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

