    <front>

      <p type="notae">Sancti Vincentii Levitae et Martyris, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Beate martyr prospera</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_1_1">Beate martyr, prospera</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_1_2">diem triumphalem tuum</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_1_3">quo sanguinis merces tibi</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_1_4">corona, Vincenti, datur.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_2_5">Hic te ex tenebris saeculi,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_2_6">tortore victo et iudice,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_2_7">evexit ad caelum dies,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_2_8">Christoque ovantem reddidit.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_3_9">Nunc angelorum particeps</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_3_10">colluces in insigni stola,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_3_11">quam testis indomabilis</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_3_12">rivis cruoris laveras.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_4_13">Levita de tribu sacra,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_4_14">minister altaris Dei,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_4_15">septem ex columnis lacteis</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_4_16">martyr triumpho nobilis.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_5_17">Tu solus, o bis inclyte,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_5_18">solus bravii duplicis</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_5_19">palmas tulisti: tu duas</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_5_20">simul parasti laureas.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_6_21">In morte victor aspera,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_6_22">dum deinde post mortem pari.</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_6_23">Victor triumpho proteris</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_6_24">solo latronem corpore.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_7_25">Per vincla, flammas, ungulas,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_7_26">per carceralem stipitem,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_7_27">per fragmen illud testeum,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_7_28">quo parta crevit gloria;</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_8_29">Adesto nunc, et percipe</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_8_30">voces precantum supplices</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_8_31">nostri reatus efficax</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_8_32">orator ad thronum Dei.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0115_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_9_33">Deo Patri sit gloria</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0115_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

