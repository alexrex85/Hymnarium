  <text>

    <front>

      <p type="notae">In Natali Virginum</p>

    </front>

    <body>

      <head type="incipit">Iesu corona virginum</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_32_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_32_1_1">I[h]esu, corona virginum:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_32_1_2">quem mater illa concepit:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_32_1_3">quae sola virgo parturit:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_32_1_4">haec vota clemens accipe.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_32_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_32_2_5">Qui pascis inter lilia:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_32_2_6">septus choreis virginum:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_32_2_7">sponsus decorus gloria:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_32_2_8">sponsisque reddens praemia.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_32_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_32_3_9">Quocumque pergis, virgines:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_32_3_10">secuntur, atque laudibus:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_32_3_11">post te canentes cursitant:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_32_3_12">hymnumque dulces personant.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_32_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_32_4_13">Te deprecamur largius:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_32_4_14">nostris adauge mentibus:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_32_4_15">nescire prorsus omnia:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_32_4_16">corruptionis vulnera.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_32_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_32_5_17">Gloria tibi Domine:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_32_5_18">gloria Unigenito:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_32_5_19">una cum sancto Spiritu:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_32_5_20">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

