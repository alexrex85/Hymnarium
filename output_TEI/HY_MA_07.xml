    </front>

    <body>

      <head type="incipit">Amore Christi nobilis</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_07_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_07_1_1">Amore Christi nobilis:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_07_1_2">et Filius tonitrui:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_07_1_3">archana Iohannes Dei:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_07_1_4">fatu revelavit sacro.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_07_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_07_2_5">Captis solebat piscibus:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_07_2_6">patris senectam pascere:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_07_2_7">turbante dum natat salo:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_07_2_8">immobilis fide stetit.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_07_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_07_3_9">Hamum profundo merserat:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_07_3_10">piscatus est Verbum Dei:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_07_3_11">iactavit undis retia:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_07_3_12">vitam levavit hominum.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_07_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_07_4_13">Piscis bonus pia est fides:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_07_4_14">mundi supernatans salum:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_07_4_15">subnixa Christi pectore:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_07_4_16">sancto locuta Spiritu.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_07_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_07_5_17">In principio erat Verbum:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_07_5_18">et Verbum erat apud Deum:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_07_5_19">et Deus erat Verbum:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_07_5_20">hoc erat in principio apud Deum.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_MA_07_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_MA_07_6_21">Omnia per ipsum facta sunt:</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_MA_07_6_22">sed laude ipse resonet:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_MA_07_6_23">et laureatus Spiritu:</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_MA_07_6_24">scriptis coronetur suis.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_MA_07_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_MA_07_7_25">Commune multis passio:</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_MA_07_7_26">cruorque delictum lavans:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_MA_07_7_27">hoc morte praestat martyrum:</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_MA_07_7_28">quod fecit esse martyres.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_MA_07_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_MA_07_8_29">Victus tamen ab impiis:</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_MA_07_8_30">calente olivo ducitur:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_MA_07_8_31">tersisse mundi pulverem:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_MA_07_8_32">stetisse victor aemuli.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_MA_07_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_MA_07_9_33">Gloria tibi Domine:</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_MA_07_9_34">gloria Unigenito:</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_MA_07_9_35">una cum sancto Spiritu:</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_MA_07_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

