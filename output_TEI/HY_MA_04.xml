  <text>

    <front>

      <p type="notae">Sabbato VI [de Adventu]</p>

    </front>

    <body>

      <head type="incipit">Mysterium Ecclesiae</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_04_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_04_1_1">Mysterium ecclesiae:</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_04_1_2">hymnum Christo referimus:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_04_1_3">quem genuit puerpera:</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_04_1_4">Verbum Patris in Filio.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_04_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_04_2_5">Sola in sexu foemina:</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_04_2_6">electa es in saeculo:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_04_2_7">quae meruisti Dominum:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_04_2_8">sanctum portare in utero.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_04_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_04_3_9">Vates antiqui temporis:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_04_3_10">praedixerat quod factum est:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_04_3_11">quia Virgo conciperet:</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_04_3_12">et pareret Emanuhel.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_MA_04_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_MA_04_4_13">Mysterium hoc magnum est:</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_MA_04_4_14">Mariae quod concessum est:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_MA_04_4_15">ut Deum per quem omnia:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_MA_04_4_16">esse videret prodere.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_MA_04_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_MA_04_5_17">Vere gratia plena es:</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_MA_04_5_18">et gloriosa permanes:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_MA_04_5_19">quia ex te nobis natus est Christus:</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_MA_04_5_20">per quem facta sunt omnia.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_MA_04_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_MA_04_6_21">Pastores qui audierunt:</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_MA_04_6_22">gloriam Deo cantarunt:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_MA_04_6_23">cucurrerunt in Bethleem:</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_MA_04_6_24">natum videre Dominum.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_MA_04_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_MA_04_7_25">Sic magi ab ortu solis:</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_MA_04_7_26">per stellae inditium:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_MA_04_7_27">portantes typum gentium:</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_MA_04_7_28">primi offerunt munera.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_MA_04_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_MA_04_8_29">Rogemus ergo populi:</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_MA_04_8_30">Dei Matrem et Virginem:</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_MA_04_8_31">ut ipsa nobis impetret:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_MA_04_8_32">pacem et indulgentiam.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_MA_04_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_MA_04_9_33">Gloria tibi Domine:</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_MA_04_9_34">gloria Unigenito:</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_MA_04_9_35">una cum sancto Spiritu:</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_MA_04_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

