    <front>

      <p type="notae">In Festo Omnium Sanctorum, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Deo fruentes fulgidae</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_1_1">Deo fruentes, fulgidae,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_1_2">salvete, Cives Patriae,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_1_3">regni micantis aulici,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_1_4">portus beantis Incolae.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_2_5">Solis nitore perpetis</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_2_6">Regina gaudet siderum:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_2_7">urbis volantes muniunt</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_2_8">caelestis arcem Milites.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_3_9">Vallatur urbs iaspide:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_3_10">fundant lapilli moenia:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_3_11">illic Prophetis assident</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_3_12">legis duces Apostoli.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_4_13">Hic candidatus Martyrum</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_4_14">trophaea fert exercitus,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_4_15">qui dimicantes plurimo</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_4_16">vicere mortem sanguine.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_5_17">Hic infulati Praesules,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_5_18">et literarum lumina:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_5_19">illic Sacerdotes sacra</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_5_20">Agni fruuntur victima.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_6_21">Ieiunia eremus convenis</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_6_22">apponit aeternas dapes:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_6_23">hic Virgines castissima</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_6_24">Sponso maritant lilia.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_7_25">Et vos avete, Caelites,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_7_26">quos nostra tellus aethere</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_7_27">donavit, astris civium</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_7_28">beata mittens agmina.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_8_29">O Turba magna, respice</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_8_30">pulchrae Sionis exules;</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_8_31">fac nos serentes lacrymis</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_8_32">referre messem gaudii.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0104_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0104_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

