    <body>

      <head type="incipit">Iesu corona celsior</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_1_1">Iesu, corona celsior</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_1_2">et veritas sublimior,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_1_3">qui confitenti servulo</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_1_4">reddis perenne praemium.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_2_5">Da supplicanti coetui,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_2_6">huius rogatu, tristium</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_2_7">remissionem criminum,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_2_8">rumpendo nexum vinculi.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_3_9">Anni reverso tempore,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_3_10">dies reluxit lumine</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_3_11">quo sanctus hic de corpore</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_3_12">sedes adivit caelitum.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_4_13">Hinc vana terrae gaudia.</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_4_14">et laeta cultu praedia</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_4_15">polluta sorde deputans,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_4_16">ovans tenet caelestia.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_5_17">Te, Christe, Rex piissime,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_5_18">hic confitendo iugiter</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_5_19">calcavit imi fortiter</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_5_20">regem superbum Tartari.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_6_21">Virtute firmus et fide,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_6_22">amore Christi fervidus,</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_6_23">ieiuna membra deferens</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_6_24">dapes supernas obtinet.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_7_25">Proinde te, Piissime,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_7_26">precamur omnes supplices:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_7_27">nobis ut, huius gratia,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_7_28">noxae remittas debita.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0304_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_8_29">Deo Patri sit gloria,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_8_30">eiusque soli Filio,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_8_31">cum Spiritu Paraclito</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0304_8_32">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

