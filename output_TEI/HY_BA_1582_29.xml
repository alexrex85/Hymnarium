    <front>

      <p type="notae">In Festo Sancti Andreae Apostoli, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Post Petrum primum principem</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1582_29_1_1">Post Petrum primum principem,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1582_29_1_2">Andreas est apostolus:</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1582_29_1_3">verbum salutis praedicans,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1582_29_1_4">Achaia in provincia.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1582_29_2_5">Captus in Patra oppido,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1582_29_2_6">diro traditur carceri,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1582_29_2_7">ferali poena caeditur:</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1582_29_2_8">tortor callet vesania.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1582_29_3_9">Dilaniatus ictibus</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1582_29_3_10">ligno crucis suspenditur:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1582_29_3_11">non cessat vivens biduo,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1582_29_3_12">fidem docere populum.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1582_29_4_13">Clamor plebis attollitur,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1582_29_4_14">charus Deo exposcitur:</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1582_29_4_15">reddi pius et innocens:</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1582_29_4_16">sanctus, bonusque quaeritur.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1582_29_5_17">Fallax tunc ad patibulum,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1582_29_5_18">quasi solutum properat:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1582_29_5_19">devotus martyr in poenis,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1582_29_5_20">orat ne arctioribus.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1582_29_6_21">Loris resolvat impius,</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1582_29_6_22">divinis demptus muniis:</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1582_29_6_23">frater instigat iurgiis,</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1582_29_6_24">iustisque querimoniis.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1582_29_7_25">Eant tecum quae tua sunt,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1582_29_7_26">Aegea o durissime:</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1582_29_7_27">completa eius passio,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1582_29_7_28">devicto hoste callido.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1582_29_8_29">Imploret ergo meritis</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1582_29_8_30">suis, pro nostris actibus,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1582_29_8_31">ut mereamur consequi:</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1582_29_8_32">in fine sancti premia.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1582_29_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1582_29_9_33">Gloria tibi Domine,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1582_29_9_34">gloria Unigenito,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1582_29_9_35">una cum sancto Spiritu,</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1582_29_9_36">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

