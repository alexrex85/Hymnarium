    <body>

      <head type="incipit">Rector potens verax Deus</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0006_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_1_1">Rector potens, verax Deus,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_1_2">qui temperas rerum vices,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_1_3">splendore mane instruis</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_1_4">et ignibus meridiem.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0006_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_2_5">Extingue flammas litium,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_2_6">aufer calorem noxium,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_2_7">confer salutem corporum</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_2_8">veramque pacem cordium.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0006_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_3_9">Praesta, Pater piissime,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_3_10">per Iesum Christum Dominum,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_3_11">qui tecum in perpetuum</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0006_3_12">regnat cum sancto Spiritu. Amen.</l>
      </lg>

    </body>

