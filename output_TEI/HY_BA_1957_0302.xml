    <front>

      <p type="notae">In natali unius Martyris, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Deus tuorum militum</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0302_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_1_1">Deus tuorum militum</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_1_2">sors et corona, praemium,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_1_3">laudes canentes martyris</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_1_4">absolve nexum criminis.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0302_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_2_5">Hic nempe mundi gaudia,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_2_6">et blanda vitae commoda</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_2_7">caduca rite deputans,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_2_8">pervenit ad caelestia.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0302_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_3_9">Poenas cucurrit fortiter,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_3_10">et sustulit viriliter:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_3_11">fuso triumphans sanguine</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_3_12">aeterna dona possidet.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0302_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_4_13">Hic nos precantes supplices</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_4_14">te poscimus, Piissime,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_4_15">in hoc triumpho martyris,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_4_16">dimitte noxam servulis.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0302_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_5_17">Deo Patri sit gloria,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_5_18">eiusque soli Filio,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_5_19">cum Spiritu Paraclito</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0302_5_20">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

