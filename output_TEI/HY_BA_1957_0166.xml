    <front>

      <p type="notae">In Festo Beatae Mariae Virginis Reginae, ad Laudes</p>

    </front>

    <body>

      <head type="incipit">Rerum supremo in vertice</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0166_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_1_1">Rerum supremo in vertice</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_1_2">Regina, Virgo, sisteris,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_1_3">exuberanter omnium</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_1_4">ditata pulchritudine.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0166_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_2_5">Princeps opus formosior</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_2_6">Verbo creanti praenites,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_2_7">praedestinata Filium,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_2_8">qui protulit te, gignere.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0166_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_3_9">Ut Christus alta ab arbore</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_3_10">Rex purpuratus sanguine,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_3_11">sic passionis particeps,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_3_12">tu Mater es viventium.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0166_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_4_13">Tantis decora laudibus,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_4_14">ad nos ovantes respice,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_4_15">tibique summe gratulans</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_4_16">quod fundimus praeconium.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0166_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_5_17">Iesu, tibi sit gloria,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_5_18">qui natus es de Virgine,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_5_19">cum Patre et almo Spiritu</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0166_5_20">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

