    <body>

      <head type="incipit">Nunc sancte nobis Spiritus</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_MA_38_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_MA_38_1_1">Nunc sancte nobis Spiritus,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_MA_38_1_2">unum Patri cum Filio,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_MA_38_1_3">dignare promptus ingeri,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_MA_38_1_4">nostro refusus pectori.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_MA_38_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_MA_38_2_5">Os, lingua, mens, sensus, vigor,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_MA_38_2_6">confessionem personet:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_MA_38_2_7">flammescat igne caritas,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_MA_38_2_8">accendat ardor proximos.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_MA_38_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_MA_38_3_9">Praesta Pater piissime,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_MA_38_3_10">per Iesum Christum Dominum:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_MA_38_3_11">qui tecum in perpetuum</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_MA_38_3_12">regnat cum sancto Spiritu. Amen.</l>
      </lg>

    </body>

