    <front>

      <p type="notae">In Festo Sancti Barnabae Apostoli, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Legis supernae nuntio</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_1_1">Legis supernae nuntio</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_1_2">laudes canamus Barnabae,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_1_3">qui missus urbem Numini,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_1_4">urbique Numen attulit.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_2_5">Fundum paternum distrahit,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_2_6">empturus agro sidera:</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_2_7">almoque plenus Spiritu</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_2_8">Verbum revelat gentibus.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_3_9">Dum spargit ignes caelicos,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_3_10">incendit aras daemonum;</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_3_11">signisque et ore fulminans</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_3_12">nomen Tonantis respuit.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_4_13">Sedes deinde gestiens</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_4_14">adit parentes Insubrum;</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_4_15">intrare sed diis negat</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_4_16">profana cultis moenia.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_5_17">Qua semen admittit solum,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_5_18">semen salutis iniicit;</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_5_19">crucisque signa subrigens,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_5_20">ascribit axi milites.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_6_21">Mox fonte sacro civium</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_6_22">submissa mergit tempora;</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_6_23">et primus aris immolat</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_6_24">caelestis Agni victimam.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_7_25">Nunc inter astra lumine</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_7_26">gaudens beato caelitum,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_7_27">tuere quos fons et tuus</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_7_28">cinis sepultus consecrat.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0167_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_8_29">Patri simulque Filio</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_8_30">tibique, sancte Spiritus,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_8_31">sicut fuit, sit iugiter</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0167_8_32">saeclum per omne gloria. Amen.</l>
      </lg>

    </body>

