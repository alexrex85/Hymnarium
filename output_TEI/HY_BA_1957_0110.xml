      <p type="notae">In Festo Immaculatae Conceptionis Beatae Mariae Virginis, ad Laudes</p>

    </front>

    <body>

      <head type="incipit">Praeclara Custos Virginum</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0110_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_1_1">Praeclara Custos Virginum,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_1_2">intacta Mater Numinis,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_1_3">caelestis aulae Ianua,</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_1_4">Spes nostra, caeli Gaudium.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0110_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_2_5">Inter rubeta Lilium,</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_2_6">Columba formosissima,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_2_7">Virgo e radice germinans</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_2_8">nostro medelam vulneri.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0110_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_3_9">Turris draconi impervia:</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_3_10">amica Stella naufragis,</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_3_11">tuere nos a fraudibus,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_3_12">tuaque luce dirige!</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0110_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_4_13">Erroris umbras discute,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_4_14">syrtes dolosas amove,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_4_15">fluctus tot inter, deviis</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_4_16">tutam reclude semitam.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0110_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_5_17">Iesu, tibi sit gloria,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_5_18">qui natus es de Virgine,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_5_19">cum Patre et almo Spiritu</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0110_5_20">in sempiterna saecula. Amen.</l>
      </lg>

    </body>

