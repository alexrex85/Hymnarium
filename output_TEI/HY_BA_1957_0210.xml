    <front>

      <p type="notae">Sancti Simpliciani Episcopi et Confessoris, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Simpliciani carmine</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_1_1">Simpliciani carmine</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_1_2">laudem canamus supplici,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_1_3">qui luce gaudens, aureo</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_1_4">fidem coronat lumine.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_2_5">Praecessor hunc Ambrosius</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_2_6">insignit: isque proximus</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_2_7">morti, senem vicarium</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_2_8">sedem mereri praedicat.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_3_9">Felix Patris successio!</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_3_10">Haeres beatus infulae!</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_3_11">Ter voce dignus Insubrum</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_3_12">praesul tiara dicitur.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_4_13">Subit senecta praegravis</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_4_14">gregis regendi pondera;</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_4_15">sed mentis ignitus vigor</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_4_16">et sanctitas vires dedit.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_5_17">Caelestis orbi claruit</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_5_18">doctrina toti praesulis:</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_5_19">eumque patrum consulit</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_5_20">coetus rogantum Punicus.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_6_21">Aurelium pius monet</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_6_22">sectam Manetis impiam</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_6_23">damnare, et unda naufragam</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_6_24">fidem salubri quaerere.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_7_25">Verbi Dei praeconio</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_7_26">spargit salutis semina,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_7_27">invicta veri Numinis</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_7_28">vexilla Romae subrigens.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_8_29">Iubet sacratis plurimos</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_8_30">caelo renasci fluctibus,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_8_31">quos rhetor inter nobilis</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_8_32">et Victorinus credidit.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0210_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0210_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

