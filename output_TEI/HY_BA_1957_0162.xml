      <p type="notae">Translatio Sancti Nazarii Martyris, ad Laudes et ad Vesperas</p>
      <p type="notae">In Festo Sanctorum Nazarii et Celsi Martyrum, ad Laudes et ad Vesperas</p>

    </front>

    <body>

      <head type="incipit">Sacri triumphales tui</head>

      <lg n="1" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_1">
        <l n="1" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_1_1">Sacri triumphales tui,</l>
        <l n="2" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_1_2">Dux magne, palmas dicimus,</l>
        <l n="3" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_1_3">quod arma, virtus, et Crucis</l>
        <l n="4" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_1_4">vernet trophaeum praelii.</l>
      </lg>
      <lg n="2" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_2">
        <l n="5" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_2_5">Modis canora mysticis</l>
        <l n="6" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_2_6">nunc turba laudem concinit,</l>
        <l n="7" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_2_7">Nazare, lux, vitae decus,</l>
        <l n="8" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_2_8">apostolorum particeps.</l>
      </lg>
      <lg n="3" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_3">
        <l n="9" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_3_9">Petri coronaris fide,</l>
        <l n="10" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_3_10">sacroque Pauli dogmate:</l>
        <l n="11" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_3_11">ungente Lino praesule,</l>
        <l n="12" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_3_12">muniris almo Spiritu.</l>
      </lg>
      <lg n="4" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_4">
        <l n="13" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_4_13">Celsum sequacem praelii,</l>
        <l n="14" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_4_14">tanti sequacem nominis,</l>
        <l n="15" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_4_15">pari coronatum fide,</l>
        <l n="16" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_4_16">Christo sacrasti victimam.</l>
      </lg>
      <lg n="5" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_5">
        <l n="17" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_5_17">Caelo locans substantiam,</l>
        <l n="18" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_5_18">aerugo quam non devorat,</l>
        <l n="19" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_5_19">gentes trahens ad gratiam,</l>
        <l n="20" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_5_20">talenta sacra duplicans.</l>
      </lg>
      <lg n="6" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_6">
        <l n="21" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_6_21">Sic fluctuantes vortices</l>
        <l n="22" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_6_22">fixis premens vestigiis,</l>
        <l n="23" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_6_23">donas ademptos patriae,</l>
        <l n="24" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_6_24">morti tributos aequoris.</l>
      </lg>
      <lg n="7" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_7">
        <l n="25" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_7_25">His rebus actis inclyte,</l>
        <l n="26" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_7_26">sancto recisus vertice,</l>
        <l n="27" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_7_27">caeli coronam praeferens,</l>
        <l n="28" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_7_28">vitae nitescis praemio.</l>
      </lg>
      <lg n="8" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_8">
        <l n="29" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_8_29">Attende vota supplicum,</l>
        <l n="30" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_8_30">potens precator Numinis,</l>
        <l n="31" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_8_31">amator et verbi Dei,</l>
        <l n="32" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_8_32">legisque doctor caelicae.</l>
      </lg>
      <lg n="9" type="tetrastichon_iambicum" xml:id="HY_BA_1957_0162_9">
        <l n="33" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_9_33">Deo Patri sit gloria,</l>
        <l n="34" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_9_34">eiusque soli Filio,</l>
        <l n="35" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_9_35">cum Spiritu Paraclito</l>
        <l n="36" type="dimeter_iambicus" xml:id="HY_BA_1957_0162_9_36">nunc et per omne saeculum. Amen.</l>
      </lg>

    </body>

